{
  "name": "frontend",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/enforce-exact-expo-pin.js && NODE_OPTIONS=--max-old-space-size=5632 node --max-old-space-size=5632 node_modules/expo/bin/cli start --port 3000",
    "build": "yarn export:web && node -e \"const fs=require('fs');fs.rmSync('build',{recursive:true,force:true});fs.cpSync('dist','build',{recursive:true});console.log('build/ synced from dist/');\"",
    "expo": "expo_run(){ NODE_OPTIONS=--max-old-space-size=5632 node --max-old-space-size=5632 node_modules/expo/bin/cli \"$@\"; }; expo_run",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "node scripts/enforce-exact-expo-pin.js && python3 ../scripts/auto_fixer_corruption_guard.py && node scripts/i18n-seed-safe.js && node scripts/verify-package-json.js && node scripts/payment-picker-viewport-guard.js && node scripts/runtime-crash-sentinel.js --scope=critical && node scripts/theme-build-gate.js && node scripts/theme-token-validity-gate.js && node scripts/theme-palette-prop-gate.js && node scripts/nav-lock-sync-gate.js && node scripts/selector-validity-gate.js && node scripts/sidenav-gallery-parity-gate.js && node scripts/pricing-policy-drift-gate.js && METRO_MAX_WORKERS=1 node node_modules/expo/bin/cli export --platform web --max-workers 1 && node scripts/bump-sw.js && node scripts/precompress-assets.js && python3 ../scripts/responsive_layout_gate.py && node scripts/seo-inject.js dist",
    "guard:auto-fixer": "python3 ../scripts/auto_fixer_corruption_guard.py",
    "i18n:seed": "python3 ../scripts/i18n_v2_seed_locales.py",
    "i18n:seed:safe": "node scripts/i18n-seed-safe.js",
    "i18n:add": "python3 ../scripts/i18n_add_key.py",
    "verify-package-json": "node scripts/enforce-exact-expo-pin.js && node scripts/verify-package-json.js",
    "theme:build-gate": "node scripts/theme-build-gate.js",
    "theme:token-gate": "node scripts/theme-token-validity-gate.js",
    "bump-sw": "node scripts/bump-sw.js",
    "precompress": "node scripts/precompress-assets.js",
    "lint": "expo lint",
    "i18n:autofix:literals:dry": "node scripts/i18n-literal-autofix.js --min-repeats=2 --roots=src/components,app",
    "i18n:autofix:literals": "node scripts/i18n-literal-autofix.js --write --min-repeats=2 --roots=src/components,app",
    "sdk56:readiness": "node scripts/sdk56-readiness.js",
    "sdk56:cutover:auto": "node scripts/sdk56-cutover-runner.js",
    "test:payment-picker-viewport-guard": "node scripts/payment-picker-viewport-guard.js",
    "runtime-crash-sentinel": "node scripts/runtime-crash-sentinel.js --scope=critical",
    "runtime-crash-sentinel:full": "node scripts/runtime-crash-sentinel.js --scope=full",
    "i18n-zero-lock": "node scripts/i18n-zero-lock.js",
    "test:visual:subscription-payments": "node node_modules/@playwright/test/cli.js test e2e/subscription-payments-visual-regression.spec.ts --project=desktop-chromium --reporter=list",
    "test:welcome:first-paint": "node node_modules/@playwright/test/cli.js test e2e/welcome-first-paint-regression.spec.ts --reporter=list",
    "test:welcome:first-paint:embed": "RUN_WELCOME_EMBED_E2E=1 node node_modules/@playwright/test/cli.js test e2e/welcome-first-paint-regression.spec.ts --project=desktop-chromium --grep=\"embedded welcome still paints immediately\" --reporter=list",
    "theme:palette-prop-gate": "node scripts/theme-palette-prop-gate.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@opentelemetry/api": "1.9.1",
