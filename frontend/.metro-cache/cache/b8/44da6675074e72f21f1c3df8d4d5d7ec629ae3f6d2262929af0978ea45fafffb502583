lus printfunctionaliteit.\",\n    \"welcome.faq.a7\": \"Vanaf het Basisplan krijg je gedetailleerde voortgangsregistratie met visuele grafieken en analyses. Premiumgebruikers krijgen AI-gestuurde inzichten, prestatiebeoordelingen en vaardigheidsdashboarden om hun groei in de loop van de tijd te volgen.\",\n    \"welcome.faq.accessibility.aiRecommendation\": \"Open AI aanbevolen FAQ\",\n    \"welcome.faq.accessibility.categoryChip\": \"Filter FAQ-categorie\",\n    \"welcome.faq.accessibility.explorePlatform\": \"Verken platform vanuit FAQ\",\n    \"welcome.faq.accessibility.mostViewed\": \"Open het meest bekeken FAQ-item\",\n    \"welcome.faq.accessibility.startTrial\": \"Start gratis proefperiode vanuit FAQ\",\n    \"welcome.faq.category.adoption\": \"Adoptie\",\n    \"welcome.faq.category.compliance\": \"Naleving\",\n    \"welcome.faq.category.general\": \"Algemeen\",\n    \"welcome.faq.category.getting-started\": \"Aan de slag\",\n    \"welcome.faq.category.integrations\": \"Integraties\",\n    \"welcome.faq.category.performance\": \"Prestatie\",\n    \"welcome.faq.category.pricing\": \"Prijzen\",\n    \"welcome.faq.category.roadmap\": \"Roadmap\",\n    \"welcome.faq.category.roi\": \"ROI\",\n    \"welcome.faq.category.security\": \"Beveiliging\",\n    \"welcome.faq.category.support\": \"Ondersteuning\",\n    \"welcome.faq.confidence.high\": \"hoog\",\n    \"welcome.faq.confidence.low\": \"laag\",\n    \"welcome.faq.confidence.medium\": \"gemiddeld\",\n    \"welcome.faq.contactBtn\": \"Contact Ondersteuning\",\n    \"welcome.faq.contactLabel\": \"Heb je nog vragen?\",\n    \"welcome.faq.default.annual.answer\": \"Antwoord\",\n    \"welcome.faq.default.annual.question\": \"Vraag\",\n    \"welcome.faq.default.cancel.answer\": \"Antwoord\",\n    \"welcome.faq.default.cancel.question\": \"Vraag\",\n    \"welcome.faq.default.free.answer\": \"Antwoord\",\n    \"welcome.faq.default.free.question\": \"Vraag\",\n    \"welcome.faq.empty\": \"Leeg\",\n    \"welcome.faq.enter