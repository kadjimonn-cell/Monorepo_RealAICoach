eCenter.actionHub.subtitle\": \"Users checking cookies often need the next linked trust surface immediately, so those pathways stay visible here.\",\n    \"cookieCenter.actionHub.title\": \"Continue the trust journey from browser controls to data rights\",\n    \"cookieCenter.actions.gdpr.body\": \"Understand the rights and lawful basis implications behind browser-level consent and storage.\",\n    \"cookieCenter.actions.gdpr.title\": \"Review GDPR rights\",\n    \"cookieCenter.actions.privacy.body\": \"See how cookie behavior connects to data collection, retention, and rights.\",\n    \"cookieCenter.actions.privacy.title\": \"Review Privacy Policy\",\n    \"cookieCenter.actions.request.body\": \"Export or delete personal data through the verified privacy pathway.\",\n    \"cookieCenter.actions.request.title\": \"Open privacy request flow\",\n    \"cookieCenter.changelog.1\": \"Rebuilt Cookie Policy into the same Trust Center family as Privacy, Terms, Security, and GDPR.\",\n    \"cookieCenter.changelog.2\": \"Clarified the difference between essential session continuity and optional preference storage.\",\n    \"cookieCenter.changelog.3\": \"Connected cookie explanations to privacy rights and related legal trust surfaces.\",\n    \"cookieCenter.changelog.title\": \"What changed in this Cookie Policy experience\",\n    \"cookieCenter.contact.body\": \"If you need help understanding how browser storage affects your account, privacy controls, or sign-in continuity, use our privacy and support pathways below.\",\n    \"cookieCenter.contact.policy\": \"Privacy and GDPR Trust Centers remain linked for full rights context\",\n    \"cookieCenter.contact.privacy\": \"privacy@realaicoach.app\",\n    \"cookieCenter.contact.support\": \"Help & Support workspace\",\n    \"cookieCenter.contact.title\": \"Cookie, consent, or browser-state questions\",\n    \"cookieCenter.fact.consent.body\": \"Consent-related browser state helps us respect prior trust choices.\",\n    \"cookieCenter.fact.consent.title\": \"Consent records\",\n    \"cookieCenter.fact.control.body\": \"Browser settings and privacy flows give you meaningful control over cookie behavior.\",\n    \"cookieCenter.fact.control.title\": \"User control\",\n    \"cookieCenter.fact.essential.body\": \"Some browser storage is required for sign-in, session continuity, and account safety.\",\n    \"cookieCenter.fact.essential.title\": \"Essential continuity\",\n    \"cookieCenter.fact.preferences.body\": \"Theme, language, and some display choices rely on preference storage.\",\n    \"cookieCenter.fact.preferences.title\": \"Preference memory\",\n    \"cookieCenter.hero.badge\": \"COOKIE TRUST CENTER\",\n    \"cookieCenter.hero.cta.manage\": \"Manage My Data\",\n    \"cookieCenter.hero.cta.privacy\": \"Review Privacy Policy\",\n    \"cookieCenter.hero.imageAlt\": \"Abstract browser privacy and preference background\",\n    \"cookieCenter.hero.meta.linkage\": \"Connected to Privacy, Security, and GDPR trust pages\",\n    \"cookieCenter.hero.meta.scope\": \"Covers cookies, browser storage, and preference continuity\",\n    \"cookieCenter.hero.meta.updated\": \"Last updated: March 20, 2026\",\n    \"cookieCenter.hero.subtitle\": \"This page explains the browser-level technologies that keep sessions secure, preferences persistent, and trust choices understandable across the platform.\",\n    \"cookieCenter.hero.title\": \"Cookie Policy that explains trade-offs clearly, not just consent mechanics.\",\n    \"cookieCenter.hero.version\": \"Version 2026.2\",\n    \"cookieCenter.section.controls.b1\": \"Use browser controls to clear or block stored cookies\",\n    \"cookieCenter.section.controls.b2\": \"Use platform settings and privacy pathways for theme/language or consent-related preferences\",\n    \"cookieCenter.section.controls.b3\": \"Review Privacy Policy and GDPR pages for related data-rights implications\",\n    \"cookieCenter.section.controls.p1\": \"You can usually review, block, or delete cookies through your browser settings. You can also manage some platform-level preferences directly through product settings or privacy-control surfaces.\",\n    \"cookieCenter.section.controls.p2\": \"Blocking essential cookies may affect sign-in, route continuity, localization, or security workflows. We therefore explain the consequences rather than presenting cookie controls as consequence-free toggles.\",\n    \"cookieCenter.section.controls.summary\": \"Users can control cookies through browser settings and platform preference surfaces, though blocking some categories can change product behavior.\",\n    \"cookieCenter.section.controls.title\": \"How you can manage cookies and preferences\",\n    \"cookieCenter.section.focus\": \"Pin section\",\n    \"cookieCenter.section.overview.b1\": \"Includes cookies, local storage, and preference-related browser data\",\n    \"cookieCenter.section.overview.b2\": \"Separates essential service continuity from optional preference or measurement use\",\n    \"cookieCenter.section.overview.b3\": \"Connects cookie explanations to privacy and legal trust surfaces\",\n    \"cookieCenter.section.overview.p1\": \"Cookies and similar browser storage technologies help RealAICoach keep sessions secure, remember selected preferences, maintain language and theme continuity, and understand aggregate service behavior.\",\n    \"cookieCenter.section.overview.p2\": \"We aim to explain cookies in practical terms so users can understand what is essential for the service to function, what is optional, and how browser-level control affects the product experience.\",\n    \"cookieCenter.section.overview.summary\": \"A clear explanation of how cookies, local storage, and device preferences support authentication, usability, and trust continuity.\",\n    \"cookieCenter.section.overview.title\": \"What cookies are and why they exist\",\n    \"cookieCenter.section.thirdParty.p1\": \"Where third-party infrastructure, payments, analytics, or connected-service providers are used, they may set or rely on browser storage according to their limited operational role. We aim to avoid hidden or unexplained dependency chains.\",\n    \"cookieCenter.section.thirdParty.p2\": \"Connected services such as Google-linked experiences should always be understood alongside the Privacy Policy, because cookies and tokens can work together to preserve authenticated workflows.\",\n    \"cookieCenter.section.thirdParty.summary\": \"Some third-party service providers and connected experiences may rely on their own controlled storage or consent-related behavior.\",\n    \"cookieCenter.section.thirdParty.title\": \"Third-party and connected-service implications\",\n    \"cookieCenter.section.types.p1\": \"Some cookies are essential for signing in, maintaining your session, and protecting the platform. Others help remember settings such as language and theme. Certain limited analytics or preference tools may also rely on browser storage.\",\n    \"cookieCenter.section.types.p2\": \"We try to keep cookie usage proportionate and explainable so the Cookie Policy remains useful to real users instead of becoming a technical appendix no one can act on.\",\n    \"cookieCenter.section.types.summary\": \"Authentication, preference, consent, and limited measurement categories each serve a different purpose.\",\n    \"cookieCenter.section.types.title\": \"The categories of cookies we use\",\n    \"cookieCenter.sidebar.ctaBody\": \"Cookie controls explain browser behavior, but privacy rights and data requests live in the Privacy Trust Center and privacy workflow.\",\n    \"cookieCenter.sidebar.ctaButton\": \"Open Privacy Trust Center\",\n    \"cookieCenter.sidebar.ctaTitle\": \"Need the full data view?\",\n    \"cookieCenter.sidebar.search\": \"Search Cookie Policy\",\n    \"cookieCenter.sidebar.title\": \"Navigate cookie topics\",\n    \"cookieCenter.summary.title\": \"TL;DR — what cookies mean here\",\n    \"cookieCenter.table.thirdParty.connected\": \"Connected services\",\n    \"cookieCenter.table.thirdParty.connectedValue\": \"Some connected workflows may pair browser state with provider authorization state\",\n    \"cookieCenter.table.thirdParty.infrastructure\": \"Infrastructure\",\n    \"cookieCenter.table.thirdParty.infrastructureValue\": \"Hosting, session continuity, and reliability support\",\n    \"cookieCenter.table.thirdParty.payments\": \"Payments\",\n    \"cookieCenter.table.thirdParty.paymentsValue\": \"Payment and billing processors may rely on secure browser/session continuity\",\n    \"cookieCenter.table.types.consent\": \"Consent records\",\n    \"cookieCenter.table.types.consentValue\": \"Stores privacy/cookie consent state and related trust choices\",\n    \"cookieCenter.table.types.measurement\": \"Service measurement\",\n    \"cookieCenter.table.types.measurementValue\": \"Helps us understand aggregate service use and reliability patterns\",\n    \"cookieCenter.table.types.preferences\": \"Preferences\",\n    \"cookieCenter.table.types.preferencesValue\": \"Remembers theme, language, and selected display preferences\",\n    \"cookieCenter.table.types.session\": \"Session/authentication\",\n    \"cookieCenter.table.types.sessionValue\": \"Supports sign-in continuity, route access, and verified session state\",\n    \"cookieCenter.trustPanel.item1\": \"You can understand what breaks if essential cookies are blocked.\",\n    \"cookieCenter.trustPanel.item2\": \"Preference storage is explained in a user-facing way rather than buried in legal jargon.\",\n    \"cookieCenter.trustPanel.item3\": \"Cookie understanding now connects cleanly to privacy and GDPR rights pages.\",\n    \"cookieCenter.trustPanel.title\": \"What this means for you\",\n    \"currencySelector.labels.current\": \"Current Currency\",\n    \"currencySelector.page.title\": \"Currency\",\n    \"currencySelector.search.placeholder\": \"Search currency\",\n    \"currencySelector.states.empty\": \"No matching currencies f