.tier.free.rollout\": \"Activate instantly with zero procurement friction.\",\n    \"pricing.tier.free.subtitle\": \"Start fast with core capability and a clean upgrade path.\",\n    \"pricing.tier.free.support\": \"Community support\",\n    \"pricing.tier.free.valueLabel\": \"Launch\",\n    \"pricing.tier.premium.audience\": \"Leaders and power users running high-accountability workflows.\",\n    \"pricing.tier.premium.badge\": \"Most capable\",\n    \"pricing.tier.premium.emphasis\": \"For teams that need depth, speed, and stronger executive confidence.\",\n    \"pricing.tier.premium.feature4\": \"Advanced operating coverage for scaled use\",\n    \"pricing.tier.premium.rollout\": \"Designed for deeper usage intensity and faster response needs.\",\n    \"pricing.tier.premium.subtitle\": \"Enterprise-grade depth for leaders, power users, and high-stakes work.\",\n    \"pricing.tier.premium.support\": \"Priority support\",\n    \"pricing.tier.premium.valueLabel\": \"Accelerate\",\n    \"pricing.title\": \"Choose Your Growth Plan\",\n    \"pricing.yearly\": \"Yearly\",\n    \"pricing.yearlyPeriod\": \"/ year\",\n    \"privacyPolicy.actionHub.open\": \"Open flow\",\n    \"privacyPolicy.actionHub.subtitle\": \"Our privacy operations flow is designed so real users can take action immediately: export data, request deletion, review rights, or contact the privacy team with context already attached.\",\n    \"privacyPolicy.actionHub.title\": \"Manage your data without opening a support ticket first\",\n    \"privacyPolicy.actions.delete.body\": \"Trigger the verified deletion flow for account and linked privacy records.\",\n    \"privacyPolicy.actions.delete.title\": \"Delete my data\",\n    \"privacyPolicy.actions.export.body\": \"Request a machine-readable copy of your account, support, and platform activity records.\",\n    \"privacyPolicy.actions.export.title\": \"Export my data\",\n    \"privacyPolicy.actions.help.body\": \"Escalate a privacy, consent, retention, or legal clarification request to our operations team.\",\n    \"privacyPolicy.actions.help.title\": \"Contact privacy team\",\n    \"privacyPolicy.changelog.1\": \"Clarified connected Google data handling and limited-use obligations.\",\n    \"privacyPolicy.changelog.2\": \"Expanded retention windows and deletion workflow details for self-service requests.\",\n    \"privacyPolicy.changelog.3\": \"Added a clearer privacy operations path for export, deletion, and escalation requests.\",\n    \"privacyPolicy.changelog.title\": \"What changed in this version\",\n    \"privacyPolicy.contact.body\": \"If you need help interpreting this policy, want to escalate a privacy concern, or need a documented response for compliance review, contact our privacy operations team or use the self-service request path.\",\n    \"privacyPolicy.contact.email\": \"privacy@realaicoach.app\",\n    \"privacyPolicy.contact.help\": \"Help & Support workspace\",\n    \"privacyPolicy.contact.sla\": \"First response target: 72 hours\",\n    \"privacyPolicy.contact.title\": \"Questions, complaints, or legal notices\",\n    \"privacyPolicy.fact.collect.body\": \"Only the account, coaching, support, and connected-service data required to run the platform.\",\n    \"privacyPolicy.fact.collect.title\": \"What we collect\",\n    \"privacyPolicy.fact.rights.body\": \"Export, delete, correct, object, or contact the privacy team from one self-service path.\",\n    \"privacyPolicy.fact.rights.title\": \"Your controls\",\n    \"privacyPolicy.fact.share.body\": \"Controlled processors only — never sold, never shared for third-party advertising, never used for model training from Google user data.\",\n    \"privacyPolicy.fact.share.title\": \"Who sees it\",\n    \"privacyPolicy.fact.use.body\": \"To authenticate you, personalize coaching, support operations, billing, and platform safety.\",\n    \"privacyPolicy.fact.use.title\": \"How we use it\",\n    \"privacyPolicy.hero.badge\": \"PRIVACY TRUST CENTER\",\n    \"privacyPolicy.hero.cta.contact\": \"Contact Privacy Team\",\n    \"privacyPolicy.hero.cta.manage\": \"Manage My Data\",\n    \"privacyPolicy.hero.imageAlt\": \"Abstract encrypted data flow background\",\n    \"privacyPolicy.hero.meta.effective\": \"Effective: March 18, 2026\",\n    \"privacyPolicy.hero.meta.response\": \"Privacy operations SLA: 72 hours for first response\",\n    \"privacyPolicy.hero.meta.updated\": \"Last updated: March 18, 2026\",\n    \"privacyPolicy.hero.subtitle\": \"This page explains what we collect, why we collect it, how long we keep it, and what you can do about it — without forcing you to decode a wall of legal text first.\",\n    \"privacyPolicy.hero.title\": \"Privacy Policy built for trust, action, and transparency.\",\n    \"privacyPolicy.hero.version\": \"Version 2026.3\",\n    \"privacyPolicy.section.collection.p1\": \"Information can come directly from you, automatically from platform usage, or from connected providers you authorize. Data categories include registration details, subscription state, support records, AI conversation context, product telemetry, and lawful security logs.\",\n    \"privacyPolicy.section.collection.p2\": \"For connected Google experiences, we limit access to the minimum data needed for calendar syncing, scheduling context, and account identity. Google user data is not used for advertising and is not used to train generalized AI models.\",\n    \"privacyPolicy.section.collection.summary\": \"We collect only the information required to operate your account, coaching workflows, support, safety, and compliance obligations.\",\n    \"privacyPolicy.section.collection.title\": \"Data we collect\",\n    \"privacyPolicy.section.focus\": \"Pin section\",\n    \"privacyPolicy.section.overview.b1\": \"Applies to public visitors, signed-in users, paid subscribers, and support interactions\",\n    \"privacyPolicy.section.overview.b2\": \"Explains platform data, Google-connected data, support records, and operational telemetry\",\n    \"privacyPolicy.section.overview.b3\": \"Links directly to self-service rights and request channels\",\n    \"privacyPolicy.section.overview.p1\": \"This Privacy Policy explains how RealAICoach collects, uses, stores, secures, and deletes personal information across our website, apps, support systems, billing operations, AI coaching tools, and connected third-party integrations.\",\n    \"privacyPolicy.section.overview.p2\": \"It applies to visitors, registered users, subscribers, support requestors, and people who connect services such as Google to enable scheduling and productivity workflows. We aim to make this policy understandable before it is merely comprehensive.\",\n    \"privacyPolicy.section.overview.summary\": \"A plain-English summary of what this policy covers and when it applies.\",\n    \"privacyPolicy.section.overview.title\": \"Overview and scope\",\n    \"privacyPolicy.section.retention.p1\": \"We retain different categories of data for different periods depending on account state, legal duty, security obligations, and whether you have requested deletion. Connected-service caches are purged more aggressively than core account records.\",\n    \"privacyPolicy.section.retention.p2\": \"Deletion requests are verified before execution. Some records may be retained longer where necessary for fraud prevention, billing reconciliation, audit requirements, or dispute defense, but we aim to document those exceptions clearly.\",\n    \"privacyPolicy.section.retention.summary\": \"Retention windows exist so the product works, legal duties are met, and stale personal data does not live forever.\",\n    \"privacyPolicy.section.retention.title\": \"Retention, deletion, and storage\",\n    \"privacyPolicy.section.rights.b1\": \"Use the Manage My Data flow for export or deletion verification\",\n    \"privacyPolicy.section.rights.b2\": \"Disconnect integrations in settings to stop future connected-service syncing\",\n    \"privacyPolicy.section.rights.b3\": \"Contact privacy@realaicoach.app for jurisdiction-specific questions or appeals\",\n    \"privacyPolicy.section.rights.p1\": \"Depending on your jurisdiction, you may have rights to access, correct, delete, export, restrict, or object to processing of your personal data. We also provide channels to manage consent, disconnect integrations, and contact our privacy operations team.\",\n    \"privacyPolicy.section.rights.p2\": \"Our goal is to make rights practical, not symbolic. That is why this page links directly into self-service actions and support escalation paths instead of forcing users to decode legal language on their own.\",\n    \"privacyPolicy.section.rights.summary\": \"You can request access, correction, export, deletion, restriction, objection, or consent withdrawal using our privacy pathways.\",\n    \"privacyPolicy.section.rights.title\": \"Your rights and controls\",\n    \"privacyPolicy.section.sharing.p1\": \"We may share information with infrastructure providers, transactional email services, analytics or monitoring tools, and payment processors strictly to operate the platform. Each processor is limited by contractual and technical controls.\",\n    \"privacyPolicy.section.sharing.p2\": \"We do not sell personal information. We do not share Google user data with advertisers, data brokers, or unrelated third parties. We aim to disclose sharing by category so this page remains useful to real users and to compliance reviewers.\",\n    \"privacyPolicy.section.sharing.summary\": \"We use tightly scoped service providers to host, secure, email, and support the platform — not to resell or exploit your data.\",\n    \"privacyPolicy.section.sharing.title\": \"Sharing and processors\",\n    \"privacyPolicy.section.usage.b1\": \"Authenticate and secure your account\",\n    \"privacyPolicy.section.usage.b2\": \"Deliver AI coaching and product workflows you explicitly use\",\n    \"privacyPolicy.section.usage.b3\": \"Operate support, billing, compliance, and trust communications\",\n    \"privacyPolicy.section.usage.b4\": \"Detect abuse, monitor incidents, and maintain reliability\",\n    \"privacyPolicy.section.usage.p1\": \"Core uses include account creation, authentication, subscription management, platform personalization, coaching delivery, scheduling, support, fraud prevention, abuse detection, and service analytics. Each use should connect back to a legitimate business or legal purpose.\",\n    \"privacyPolicy.section.usage.p2\": \"Where consent is the basis, you may withdraw it. Where contract performance or legitimate interest is the basis, we aim to explain what that means in operational terms so users are not left guessing.\",\n    \"privacyPolicy.section.usage.summary\": \"We use data to deliver the service you requested, protect the platform, and comply with legal obligations.\",\n    \"privacyPolicy.section.usage.title\": \"How we use your data\",\n    \"privacyPolicy.sidebar.ctaBody\": \"Use our verified self-service request path for export or deletion, or contact privacy operations for deeper questions.\",\n    \"privacyPolicy.sidebar.ctaButton\": \"Open Manage My Data\",\n    \"privacyPolicy.sidebar.ctaTitle\": \"Need to take action?\",\n    \"privacyPolicy.sidebar.search\": \"Search this policy\",\n    \"privacyPolicy.sidebar.title\": \"Navigate the policy\",\n    \"privacyPolicy.summary.title\": \"TL;DR — what matters most\",\n    \"privacyPolicy.table.collection.account\": \"Account data\",\n    \"privacyPolicy.table.collection.accountValue\": \"Name, email, profile settings, plan state\",\n    \"privacyPolicy.table.collection.connected\": \"Connected services\",\n    \"privacyPolicy.table.collection.connectedValue\": \"Calendar events, OAuth tokens, profile identity metadata\",\n    \"privacyPolicy.table.collection.product\": \"Product usage\",\n    \"privacyPolicy.table.collection.productValue\": \"Feature usage, error diagnostics, session patterns\",\n    \"privacyPolicy.table.collection