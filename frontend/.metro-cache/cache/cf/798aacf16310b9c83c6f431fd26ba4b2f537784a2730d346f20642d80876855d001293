webhookReplay.views.retryRules\": \"Quy Tắc Thử Lại\",\n    \"welcome.benefits.aiCareer\": \"Huấn Luyện Nghề Nghiệp Bằng AI\",\n    \"welcome.benefits.aiCareerDesc\": \"Hướng dẫn nghề nghiệp cá nhân hóa từ các mô hình AI tiên tiến được đào tạo theo những thực tiễn tốt nhất trong ngành và kết quả thực tế.\",\n    \"welcome.benefits.empty\": \"Trống\",\n    \"welcome.benefits.goalTracking\": \"Theo Dõi Mục Tiêu Linh Hoạt\",\n    \"welcome.benefits.goalTrackingDesc\": \"Các mục tiêu được điều hướng bởi AI phát triển cùng với tiến độ của bạn, giữ bạn trên con đường nhanh nhất đến kết quả.\",\n    \"welcome.benefits.label\": \"CÁC KHẢ NĂNG MẠNH MẼ\",\n    \"welcome.benefits.liveAnalytics\": \"Công Cụ Phân Tích Trực Tiếp\",\n    \"welcome.benefits.liveAnalyticsDesc\": \"Bảng điều khiển thời gian thực theo dõi mọi chỉ số quan trọng, với những hiểu biết dự đoán và khuyến nghị có thể hành động.\",\n    \"welcome.benefits.productivity\": \"Công Cụ Năng Suất\",\n    \"welcome.benefits.productivityDesc\": \"Lên lịch thông minh, tối ưu hóa tập trung, và tự động hóa quy trình làm việc giúp tiết kiệm hơn 12 giờ mỗi tuần.\",\n    \"welcome.benefits.security\": \"Bảo Mật Doanh Nghiệp\",\n    \"welcome.benefits.securityDesc\": \"Mã hóa 256-bit, tuân thủ SOC 2, và cơ sở hạ tầng sẵn sàng cho GDPR bảo vệ dữ liệu của bạn ở mọi lớp.\",\n    \"welcome.benefits.subtitle\": \"Một bộ công cụ toàn diện được hỗ trợ bởi AI được thiết kế để hoạt động cùng nhau một cách liền mạch.\",\n    \"welcome.benefits.teamCollab\": \"Hợp Tác Nhóm\",\n    \"welcome.benefits.teamCollabDesc\": \"Quản lý các đội nhóm, chia sẻ kế hoạch phát triển, và theo dõi tiến độ tập thể với các công cụ làm việc nhóm của chúng tôi.\",\n    \"welcome.benefits.title\": \"Tất Cả Những Gì Bạn Cần Để Xuất Sắc\",\n    \"welcome.careers.copy\": \"Khám phá các vị trí mở, đăng ký trong vài phút và theo dõi hành trình ứng tuyển từ đầu đến cuối từ một trung tâm nghề nghiệp chuyên nghiệp.\",\n    \"welcome.careers.explore\": \"Khám phá Nghề nghiệp\",\n    \"welcome.careers.eyebrow\": \"Nghề nghiệp tại RealAICoach\",\n    \"welcome.careers.talentNetwork\": \"Tham gia Mạng Tài năng\",\n    \"welcome.careers.title\": \"Xây dựng tương lai với một đội ngũ AI doanh nghiệp.\",\n    \"welcome.careers.track\": \"Theo dõi Đơn ứng tuyển\",\n    \"welcome.cta.accessibility.about\": \"Tìm hiểu thêm về RealAICoach\",\n    \"welcome.cta.accessibility.primary\": \"Tạo tài khoản miễn phí\",\n    \"welcome.cta.accessibility.return\": \"Đăng nhập để tiếp tục\",\n    \"welcome.cta.demo\": \"Xem Demo\",\n    \"welcome.cta.headline\": \"Bước tiếp theo được đề xuất\",\n    \"welcome.cta.start\": \"Bắt Đầu Miễn Phí\",\n    \"welcome.cta.subtitle\": \"Tham gia cùng hàng nghìn chuyên gia đã sử dụng coaching hỗ trợ bởi AI.\",\n    \"welcome.cta.title\": \"Sẵn Sàng Biến Đổi Sự Nghiệp Của Bạn?\",\n    \"welcome.enterprisePulse.faqEntries\": \"Mục FAQ\",\n    \"welcome.enterprisePulse.features\": \"Các Tính năng Hoạt động\",\n    \"welcome.enterprisePulse.plans\": \"Kế hoạch\",\n    \"welcome.enterprisePulse.subtitle\": \"Thông tin tình huống trực tiếp • đã xác minh tuân thủ • sẵn sàng SLA\",\n    \"welcome.enterprisePulse.testimonials\": \"Lời chứng thực\",\n    \"welcome.enterprisePulse.title\": \"Chào mừng Enterprise Pulse\",\n    \"welcome.faq.a1\": \"Có! Kế hoạch Miễn Phí mang đến cho bạn 3 cuộc trò chuyện AI mỗi ngày, 3 kịch bản huấn luyện cho người mới, phản hồi cơ bản, hỗ trợ cộng đồng và 2 lượt tải xuống mỗi ngày - hoàn toàn miễn phí, không cần thẻ tín dụng, không giới hạn thời gian.\",\n    \"welcome.faq.a2\": \"Chúng tôi cung cấp hai kế hoạch trả phí: Cơ Bản (5.99 USD/tháng) với 10 cuộc trò chuyện AI mỗi ngày, kịch bản trung gian, theo dõi tiến độ, và xuất bản CSV/TXT. Cao Cấp (15.99 USD/tháng) mở khóa cuộc trò chuyện không giới hạn, tất cả 26+ công cụ AI, phân tích nâng cao, xuất bản PDF/DOCX/CSV, và hỗ trợ ưu tiên. Cả hai kế hoạch đều cung cấp 60% tiết kiệm với thanh toán hàng năm.\",\n    \"welcome.faq.a3\": \"Chắc chắn rồi. Bạn có thể nâng cấp, giảm cấp, hoặc hủy đăng ký của mình bất kỳ lúc nào từ Cài Đặt Tài Khoản của bạn. Các thay đổi có hiệu lực ngay lập tức, và bạn sẽ giữ được quyền truy cập vào kế hoạch hiện tại của mình cho đến khi kết thúc thời gian thanh toán của bạn.\",\n    \"welcome.faq.a4\": \"RealAICoach bao gồm 26+ công cụ AI cấp doanh nghiệp trên 8 danh mục: AI Writer Pro, AI Chatbot, AI Search, Phân Tích Nhận Thức, Cố Vấn Sức Khỏe, Thể Dục & Dinh Dưỡng, Trung Tâm Tài Chính, Tạo Hóa Đơn, SmartBuy, TravelPal, Giáo Viên Trường Học, Trung Tâm Âm Nhạc, và nhiều hơn nữa. Người dùng miễn phí có quyền truy cập vào các kịch bản cơ bản, trong khi Cao Cấp mở khóa tất cả.\",\n    \"welcome.faq.a5\": \"Có. Chúng tôi sử dụng xác thực an toàn qua Google và Microsoft SSO, tất cả dữ liệu được truyền qua các kết nối HTTPS được mã hóa, và các cuộc trò chuyện của bạn được lưu trữ một cách an toàn. Chúng tôi không bao giờ chia sẻ dữ liệu cá nhân của bạn với các bên thứ ba hoặc sử dụng nó để đào tạo các mô hình bên ngoài.\",\n    \"welcome.faq.a6\": \"Người dùng miễn phí có 2 lượt tải xuống mỗi ngày. Kế hoạch Cơ Bản thêm các xuất bản TXT và CSV với lịch sử 30 ngày. Kế hoạch Cao Cấp bao gồm tải xuống không giới hạn, lịch sử đầy đủ và tất cả định dạng xuất bao gồm PDF và DOCX - cộng với chức năng in ấn.\",\n    \"welcome.faq.a7\": \"Từ kế hoạch Cơ Bản trở đi, bạn nhận được theo dõi tiến độ chi tiết với các biểu đồ trực quan và phân tích. Người dùng Cao Cấp nhận được những hiểu biết hỗ trợ bởi AI, điểm số hiệu suất, và bảng điều khiển phân tích kỹ năng để theo dõi sự tăng trưởng của họ theo thời gian.\",\n    \"welcome.faq.accessibility.aiRecommendation\": \"Câu hỏi thường gặp do Open AI đề xuất\",\n    \"welcome.faq.accessibility.categoryChip\": \"Lọc danh mục câu hỏi thường gặp\",\n    \"welcome.faq.accessibility.explorePlatform\": \"Khám phá nền tảng từ câu hỏi thường gặp\",\n    \"welcome.faq.accessibility.mostViewed\": \"Mở mục câu hỏi thường gặp được xem nhiều nhất\",\n    \"w