ping\": \"Nova đang chuẩn bị cho cột mốc tiếp theo của bạn…\",\n    \"welcome.hero.mock.user1\": \"Tạo một kế hoạch phát triển chi tiết cho kỹ năng lãnh đạo\",\n    \"welcome.hero.nova.intro\": \"Tôi là Nova, trợ lý AI của bạn cho bất kỳ câu hỏi nào về nền tảng này.\",\n    \"welcome.hero.nova.kicker\": \"Gặp gỡ Nova\",\n    \"welcome.hero.signals.locale.copy\": \"Điều hướng ở đầu trang, bằng chứng và văn bản quyết định vẫn rõ ràng trên các địa phương hỗ trợ.\",\n    \"welcome.hero.signals.locale.title\": \"Thông điệp an toàn cho địa phương hóa\",\n    \"welcome.hero.signals.routing.copy\": \"Khách truy cập, người dùng miễn phí và các nhóm cao cấp đều được hướng tới hành động tiếp theo phù hợp nhất mà không gặp rào cản.\",\n    \"welcome.hero.signals.routing.title\": \"Hướng dẫn trạng thái kế hoạch\",\n    \"welcome.hero.signals.theme.copy\": \"Trải nghiệm mở đầu giữ nguyên độ tương phản, cách phân cấp và sự bóng bẩy trực quan nhất quán ở cả hai chế độ.\",\n    \"welcome.hero.signals.theme.title\": \"Độ trung thực sáng/tối\",\n    \"welcome.hero.stat.tools\": \"Công Cụ AI\",\n    \"welcome.hero.stat.uptime\": \"Thời Gian Hoạt Động SLA\",\n    \"welcome.hero.stat.users\": \"Người Dùng Đang Hoạt Động\",\n    \"welcome.hero.subtitle\": \"Các công cụ coaching hỗ trợ bởi AI, phân tích thời gian thực, và kế hoạch phát triển cá nhân hóa — được thiết kế cho những chuyên gia tham vọng, những người đòi hỏi kết quả.\",\n    \"welcome.hero.subtitleV2\": \"Huấn luyện lái bởi AI, trí tuệ hiệu suất trực tiếp, và kế hoạch tăng trưởng chính xác — được thiết kế cho những người chuyên nghiệp biến tham vọng thành kết quả đo lường được, tích lũy.\",\n    \"welcome.hero.summary.description\": \"Cách phân cấp phản hồi, định tuyến nhận thức kế hoạch và tín hiệu đáng tin cậy của người mua hiện đã hợp nhất trước khi khách truy cập đến với giá cả.\",\n    \"welcome.hero.summary.memory.features.action\": \"Tiếp tục đánh giá tính năng\",\n    \"welcome.hero.summary.memory.features.copy\": \"Chú