y\": \"Một cái nhìn tổng quan ngắn gọn về độ sâu sản phẩm, cấu trúc thương mại và độ dày chứng minh mà người mua thấy ngay lập tức.\",\n    \"welcome.hero.summary.signalsTitle\": \"Tín hiệu hoạt động ở đầu trang\",\n    \"welcome.hero.summary.sourcesCopy\": \"Các nguồn nhận biết giúp trải nghiệm mở đầu cảm thấy đáng tin cậy trước khi câu chuyện sản phẩm sâu hơn được hé lộ.\",\n    \"welcome.hero.summary.sourcesTitle\": \"Tín hiệu tin cậy + khả năng hiển thị\",\n    \"welcome.hero.summary.systemLabel\": \"Tư thế hệ thống\",\n    \"welcome.hero.summary.title\": \"Tất cả các nội dung phía trên trang đều hoạt động như một cổng vào doanh nghiệp nghiêm túc.\",\n    \"welcome.hero.title1\": \"Thúc đẩy\",\n    \"welcome.hero.title2\": \"Sự Phát Triển Chuyên Nghiệp Của Bạn\",\n    \"welcome.hero.value.global.copy\": \"Huấn luyện bằng 23 ngôn ngữ với mạng lưới chuyên gia toàn cầu phát triển bên cạnh bạn.\",\n    \"welcome.hero.value.global.title\": \"Quy mô Toàn cầu\",\n    \"welcome.hero.value.precision.copy\": \"Điểm số phù hợp AI, phỏng vấn giả, và điều chỉnh sự nghiệp phù hợp với vai trò, thị trường, và mục tiêu của bạn.\",\n    \"welcome.hero.value.precision.title\": \"Trí tuệ Chính xác\",\n    \"welcome.hero.value.roi.copy\": \"Phân tích lộ trình thăng tiến và các chỉ số tăng trưởng trực tiếp chứng minh tiến bộ của bạn từng tuần.\",\n    \"welcome.hero.value.roi.title\": \"ROI Đo lường được\",\n    \"welcome.heroAsSeen.title\": \"Như đã thấy trong\",\n    \"welcome.howItWorks.label\": \"CÁCH THỨC HOẠT ĐỘNG\",\n    \"welcome.howItWorks.step1Desc\": \"Đăng ký chỉ trong vài giây. Không cần thẻ tín dụng.\",\n    \"welcome.howItWorks.step1Title\": \"Tạo Tài Khoản\",\n    \"welcome.howItWorks.step2Desc\": \"Nói với AI về tham vọng và lĩnh vực tập trung của bạn.\",\n    \"welcome.howItWorks.step2Title\": \"Đặt Mục Tiêu Của Bạn\",\n    \"welcome.howItWorks.step3Desc\": \"Nhận huấn luyện cá nhân hóa và theo dõi tiến độ.\",\n    \"welcome.howItWorks.step3Title\": \"Đạt Kết Quả\",