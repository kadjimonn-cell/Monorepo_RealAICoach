atorCopy\": \"So sánh chi tiêu công cụ hàng năm của hôm nay với chi phí dự kiến để tiêu chuẩn hóa cấp độ này cho đội ngũ của bạn.\",\n    \"pricing.roi.estimatorTitle\": \"Ước lượng ROI cho\",\n    \"pricing.roi.label\": \"Sự tự tin thương mại\",\n    \"pricing.roi.outputLabel\": \"Tín hiệu tiết kiệm ước tính\",\n    \"pricing.roi.principle.1.body\": \"Miễn phí, Cơ bản và Cao cấp nâng cấp theo cách mà những người ra quyết định có thể giải thích nhanh cho các đội ngũ và người phê duyệt.\",\n    \"pricing.roi.principle.1.title\": \"Tiến trình thương mại rõ ràng\",\n    \"pricing.roi.principle.2.body\": \"Người dùng có thể bắt đầu nhỏ và mở rộng sau mà không cần thay đổi cấu trúc lộ trình hoặc mô hình quyền lợi.\",\n    \"pricing.roi.principle.2.title\": \"Nâng cấp mà không cần đặt lại quy trình\",\n    \"pricing.roi.principle.3.body\": \"Các chế độ xem hàng tháng và hàng năm giúp thấy được các sự đánh đổi trước khi ai đó đến bước thanh toán.\",\n    \"pricing.roi.principle.3.title\": \"Tính minh bạch ngân sách ngay từ đầu\",\n    \"pricing.roi.projectedWith\": \"Dự kiến với\",\n    \"pricing.roi.teamSizePlaceholder\": \"Kích thước đội\",\n    \"pricing.roi.title\": \"Ước lượng câu chuyện ngân sách trước khi bạn yêu cầu các đội thay đổi kế hoạch.\",\n    \"pricing.roi.toolSpendPlaceholder\": \"Chi tiêu hàng tháng hiện tại\",\n    \"pricing.save\": \"TIẾT KIỆM 60%\",\n    \"pricing.saveDynamic\": \"TIẾT KIỆM {pct}%\",\n    \"pricing.saveVsMonthly\": \"Tiết kiệm {pct}% so với hàng tháng\",\n    \"pricing.startPlan\": \"StartPlan\",\n    \"pricing.subtitle\": \"Bắt đầu miễn phí, mở rộng khi bạn sẵn sàng. Không phí ẩn, hủy bất cứ lúc nào.\",\n    \"pricing.tier.basic.audience\": \"Các nhà điều hành và đội nhỏ xây dựng thói quen bền vững.\",\n    \"pricing.tier.basic.badge\": \"Được khuyến nghị\",\n    \"pricing.tier.basic.emphasis\": \"Cân bằng kiểm soát chi phí, thông lượng và sự tự tin nâng cấp.\",\n    \"pricing.tier.basic.feature4\": \"Bằng chứng giá trị rõ ràng cho các đánh giá hàng tuần\",\n    \"pricing.tier.basic.rollout\": \"Phù hợp tốt cho các nhà quản lý cần đầu ra hàng tuần rõ ràng.\",\n    \"pricing.tier.basic.subtitle\": \"Cấp độ vận hành cho các đội xây dựng thực hiện hàng tuần có thể lặp lại.\",\n    \"pricing.tier.basic.support\": \"Hỗ trợ qua email\",\n    \"pricing.tier.basic.valueLabel\": \"Vận hành\",\n    \"pricing.tier.free.audience\": \"Cá nhân xác thực sự phù hợp và động lực ban đầu.\",\n    \"pricing.tier.free.emphasis\": \"Lý tưởng để chứng minh giá trị trước khi chuẩn hóa quy trình làm việc.\",\n    \"pricing.tier.free.feature4\": \"Các nguyên tắc chuẩn bị ra mắt\",\n    \"pricing.tier.free.rollout\": \"Kích hoạt ngay lập tức mà không gặp rào cản mua sắm.\",\n    \"pricing.tier.free.subtitle\": \"Bắt đầu nhanh với khả năng cốt lõi và lộ trình nâng cấp rõ ràng.\",\n    \"pricing.tier.free.support\": \"Hỗ trợ cộng đồng\",\n    \"pricing.tier.free.valueLabel\": \"Ra mắt\",\n    \"pricing.tier.premium.audience\": \"Các nhà lãnh đạo và người dùng chủ chốt thực hiện các quy trình có trách nhiệm cao.\",\n    \"pricing.tier.premium.badge\": \"Có khả năng nhất\",\n    \"pricing.tier.premium.emphasis\": \"Dành cho các đội cần chiều sâu, tốc độ và sự tự tin điều hành mạnh mẽ hơn.\",\n    \"pricing.tier.premium.feature4\": \"Bảo hiểm vận hành nâng cao cho sử dụng quy mô lớn\",\n    \"pricing.tier.premium.rollout\": \"Thiết kế cho mức độ sử dụng sâu hơn và nhu cầu phản hồi nhanh hơn.\",\n    \"pricing.tier.premium.subtitle\": \"Độ sâu cấp doanh nghiệp cho lãnh đạo, người dùng chuyên nghiệp và công việc quan trọng.\",\n    \"pricing.tier.premium.support\": \"Hỗ trợ ưu tiên\",\n    \"pricing.tier.premium.valueLabel\": \"Thúc đẩy\",\n    \"pricing.title\": \"Chọn Kế hoạch Tăng trưởng của bạn\",\n    \"pricing.yearly\": \"Hàng năm\",\n    \"pricing.yearlyPeriod\": \"YearlyPeriod\",\n    \"privacyPolicy.actionHub.open\": \"Dòng chảy mở\",\n    \"privacyPolicy.actionHub.subtitle\": \"Quy trình hoạt động quyền riêng tư của chúng tôi được thiết kế để người dùng thực sự có thể hành động ngay lập tức: xuất dữ liệu, yêu cầu xóa, xem quyền hoặc liên hệ với đội ngũ quyền riêng tư với ngữ cảnh đã được đính kèm.\",\n    \"privacyPolicy.actionHub.title\": \"Quản lý dữ liệu của bạn mà không cần mở phiếu hỗ trợ trước\",\n    \"privacyPolicy.actions.delete.body\": \"Kích hoạt luồng xóa đã xác minh cho tài khoản và hồ sơ quyền riêng tư liên kết.\",\n    \"privacyPolicy.actions.delete.title\": \"Xóa dữ liệu của tôi\",\n    \"privacyPolicy.actions.export.body\": \"Yêu cầu một bản sao có thể đọc bằng máy của tài khoản, hỗ trợ, và hồ sơ hoạt động nền tảng của bạn.\",\n    \"privacyPolicy.actions.export.title\": \"Xuất dữ liệu của tôi\",\n    \"privacyPolicy.actions.help.body\": \"Đề xuất một yêu cầu làm rõ về quyền riêng tư, đồng ý, giữ lại, hoặc pháp lý đến đội ngũ hoạt động của chúng tôi.\",\n    \"privacyPolicy.actions.help.title\": \"Liên hệ đội ngũ quyền riêng tư\",\n    \"privacyPolicy.changelog.1\": \"Làm rõ việc xử lý dữ liệu kết nối của Google và nghĩa vụ sử dụng hạn chế.\",\n    \"privacyPolicy.changelog.2\": \"Mở rộng chi tiết thời gian lưu trữ và quy trình xóa cho những yêu cầu tự phục vụ.\",\n    \"privacyPolicy.changelog.3\": \"Thêm một con đường hoạt động quyền riêng tư rõ ràng hơn cho các yêu cầu xuất, xóa và đề xuất.\",\n    \"privacyPolicy.changelog.title\": \"Điều gì đã thay đổi trong phiên bản này\",\n    \"privacyPolicy.contact.body\": \"Nếu bạn cần giúp đỡ trong việc giải thích chính sách này, muốn nâng cao một mối quan tâm về quyền riêng tư, hoặc cần một phản hồi có tài liệu cho việc xem xét tuân thủ, hãy liên hệ với đội ngũ hoạt động quyền riêng tư của chúng tôi hoặc sử dụng con đường yêu cầu tự phục vụ.\",\n    \"privacyPolicy.contact.email\": \"privacy@realaicoach.app\",\n    \"privacyPolicy.contact.help\": \"Không gian Giúp & Hỗ trợ\",\n    \"privacyPolicy.contact.sla\": \"Thời gian phản hồi đầu tiên: 72 giờ\",\n    \"privacyPolicy.contact.title\": \"Câu hỏi, khiếu nại, hoặc thông báo pháp lý\",\n    \"privacyPolicy.fact.collect.body\": \"Chỉ dữ liệu tài khoản, huấn luyện, hỗ trợ và dịch vụ kết nối cần thiết để điều hành nền tảng.\",\n    \"privacyPolicy.fact.collect.title\": \"Những gì chúng tôi thu thập\",\n    \"privacyPolicy.fact.rights.body\": \"Xuất, xóa, sửa đổi, phản đối, hoặc liên hệ với đội ngũ quyền riêng tư từ một con đường tự phục vụ.\",\n    \"privacyPolicy.fact.rights.title\": \"Những gì bạn kiểm soát\",\n    \"privacyPolicy.fact.share.body\": \"Chỉ các bộ xử lý được kiểm soát - không bao giờ bị bán, không bao giờ chia sẻ cho quảng cáo bên thứ ba, không bao giờ được sử dụng để đào tạo mô hình từ dữ liệu người dùng Google.\",\n    \"privacyPolicy.fact.share.title\": \"Ai thấy điều này\",\n    \"privacyPolicy.fact.use.body\": \"Để xác thực bạn, cá nhân hóa huấn luyện, hoạt động hỗ trợ, lập hóa đơn và đảm bảo an toàn cho nền tảng.\",\n    \"privacyPolicy.fact.use.title\": \"Cách chúng tôi sử dụng nó\",\n    \"privacyPolicy.hero.badge\": \"TRUNG TÂM TIN CẬY RIÊNG TƯ\",\n    \"privacyPolicy.hero.cta.contact\": \"Liên hệ Đội ngũ Bảo mật\",\n    \"privacyPolicy.hero.cta.manage\": \"Quản lý Dữ liệu của tôi\",\n    \"privacyPolicy.hero.imageAlt\": \"Tổng quan về lưu lượng dữ liệu mã hóa\",\n    \"privacyPolicy.hero.meta.effective\": \"Có hiệu lực: Ngày 18 tháng 3 năm 2026\",\n    \"privacyPolicy.hero.meta.response\": \"Thời gian phản hồi hoạt động bảo mật: 72 giờ cho phản hồi đầu tiên\",\n    \"privacyPolicy.hero.meta.updated\": \"Cập nhật lần cuối: Ngày 18 tháng 3 năm 2026\",\n    \"privacyPolicy.hero.subtitle\": \"Trang này giải thích những gì chúng tôi thu thập, lý do thu thập, thời gian lưu trữ và những gì bạn có thể làm — mà không cần phải giải mã một loạt văn bản pháp lý trước.\",\n    \"privacyPolicy.hero.title\": \"Chính sách Bảo mật được xây dựng dựa trên sự tin cậy, hành động và minh bạch.\",\n    \"privacyPolicy.hero.version\": \"Phiên bản 2026.3\",\n    \"privacyPolicy.section.collection.p1\": \"Thông tin có thể đến trực tiếp từ bạn, tự động từ việc sử dụng nền tảng hoặc từ các nhà cung cấp kết nối mà bạn cho phép. Các danh mục dữ liệu bao gồm chi tiết đăng ký, trạng thái đăng ký, hồ sơ hỗ trợ, ngữ cảnh cuộc trò chuyện AI, dữ liệu sản phẩm và nhật ký bảo mật hợp pháp.\",\n    \"privacyPolicy.section.collection.p2\": \"Đối với trải nghiệm kết nối Google, chúng tôi giới hạn quyền truy cập vào dữ liệu tối thiểu cần thiết cho việc đồng bộ hóa lịch, ngữ cảnh lập lịch và danh tính tài khoản. Dữ liệu người dùng Google không được sử dụng cho quảng cáo và không được sử dụng để đào tạo các mô hình AI tổng quát.\",\n    \"privacyPolicy.section.collection.summary\": \"Chúng tôi chỉ thu thập thông tin cần thiết để vận hành tài khoản của bạn, quy trình coaching, hỗ trợ, an toàn và nghĩa vụ tuân thủ.\",\n    \"privacyPolicy.section.collection.title\": \"Dữ liệu chúng tôi thu thập\",\n    \"privacyPolicy.section.focus\": \"Phần ghim\",\n    \"privacyPolicy.section.overview.b1\": \"Áp dụng cho khách truy cập công khai, người dùng đã đăng nhập, người đăng ký trả phí và tương tác hỗ trợ\",\n    \"privacyPolicy.section.overview.b2\": \"Giải thích dữ liệu nền tảng, dữ liệu kết nối Google, hồ sơ hỗ trợ và dữ liệu hoạt động\",\n    \"privacyPolicy.section.overview.b3\": \"Liên kết trực tiếp đến quyền tự phục vụ và các kênh yêu cầu\",\n    \"privacyPolicy.section.overview.p1\": \"Chính sách Bảo mật này giải thích cách RealAICoach thu thập, sử dụng, lưu trữ, bảo mật và xóa thông tin cá nhân trên trang web, ứng dụng, hệ thống hỗ trợ, hoạt động thanh toán, công cụ coaching AI và tích hợp bên thứ ba kết nối.\",\n    \"privacyPolicy.section.overview.p2\": \"Chính sách này áp dụng cho khách truy cập, người dùng đã đăng ký, người đăng ký, người yêu cầu hỗ trợ và những người kết nối dịch vụ như Google để kích hoạt lập lịch và quy trình làm việc hiệu suất. Chúng tôi hướng đến việc làm cho chính sách này dễ hiểu trước khi nó chỉ đơn giản là đầy đủ.\",\n    \"privacyPolicy.section.overview.summary\": \"Tóm tắt dễ hiểu về những gì chính sách này bao phủ và khi nào nó áp dụng.\",\n    \"privacyPolicy.section.overview.title\": \"Tổng quan và phạm vi\",\n    \"privacyPolicy.section.retention.p1\": \"Chúng tôi giữ các danh mục dữ liệu khác nhau trong các khoảng thời gian khác nhau tùy thuộc vào trạng thái tài khoản, nghĩa vụ pháp lý, nghĩa vụ bảo mật, và việc bạn có yêu cầu xóa hay không. Các bộ nhớ dịch vụ kết nối được xóa mạnh mẽ hơn so với hồ sơ tài khoản cốt lõi.\",\n    \"privacyPolicy.section.retention.p2\": \"Yêu cầu xóa được xác minh trước khi thực hiện. Một số hồ sơ có thể được giữ lại lâu hơn nếu cần cho việc ngăn chặn gian lận, đối chiếu hóa đơn, yêu cầu kiểm toán, hoặc phòng ngừa tranh chấp, nhưng chúng tôi hướng đến việc tài liệu hóa rõ ràng những ngoại lệ đó.\",\n    \"privacyPolicy.section.retention.summary\": \"Có khoảng thời gian giữ dữ liệu để sản phẩm hoạt động, nghĩa vụ pháp lý được đáp ứng, và dữ liệu cá nhân cũ không còn tồn tại mãi mãi.\",\n    \"privacyPolicy.section.retention.title\": \"Giữ lại, xóa và lưu trữ\",\n    \"privacyPolicy.section.rights.b1\": \"Sử dụng quy trình Quản lý Dữ liệu của tôi để xuất hoặc xác minh xóa\",\n    \"privacyPolicy.section.rights.b2\": \"Ngắt kết nối các tích hợp trong cài đặt để ngừng đồng bộ hóa dịch vụ kết nối trong tương lai\",\n    \"privacyPolicy.section.rights.b3\": \"Liên hệ privacy@realaicoach.app cho các câu hỏi hoặc kháng cáo theo quyền tài phán\",\n    \"privacyPolicy.section.rights.p1\": \"Tùy thuộc vào quyền tài phán của bạn, bạn có thể có quyền truy cập, sửa chữa, xóa, xuất, hạn chế hoặc phản đối việc xử lý dữ liệu cá nhân của mình. Chúng tôi cũng cung cấp các kênh để quản lý sự đồng ý, ngắt kết nối các tích hợp, và liên hệ với đội ngũ hoạt động bảo mật của chúng tôi.\",\n    \"privacyPolicy.section.rights.p2\": \"Mục tiêu của chúng tôi là làm cho quyền lợi trở nên thiết thực, không chỉ mang tính biểu tượng. Đó là lý do tại sao trang này liên kết trực tiếp đến các hành động tự phục vụ và các con đường hỗ trợ thay vì buộc người dùng phải tự giải mã ngôn ngữ pháp lý.\",\n    \"privacyPolicy.section.rights.summary\": \"Bạn có thể yêu cầu truy cập, chỉnh sửa, xuất, xóa, hạn chế, phản đối hoặc rút lại sự đồng ý bằng cách sử dụng các lối đi về quyền riêng tư của chúng tôi.\",\n    \"privacyPolicy.section.rights.title\": \"Quyền và kiểm soát của bạn\",\n    \"privacyPolicy.section.sharing.p1\": \"Chúng tôi có thể chia sẻ thông tin với các nhà cung cấp cơ sở hạ tầng, dịch vụ email giao dịch, công cụ phân tích hoặc giám sát, và các đơn vị xử lý thanh toán chỉ để vận hành nền tảng. Mỗi đơn vị xử lý bị hạn chế bởi các điều khoản hợp đồng và kiểm soát kỹ thuật.\",\n    \"privacyPolicy.section.sharing.p2\": \"Chúng tôi không bán thông tin cá nhân. Chúng tôi không chia sẻ dữ liệu người dùng Google với các nhà quảng cáo, nhà môi giới dữ liệu, hoặc bên thứ ba không liên quan. Chúng tôi nhằm mục đích công bố việc chia sẻ theo danh mục để trang này luôn hữu ích cho người dùng thực và cho các nhà đánh giá tuân thủ.\",\n    \"privacyPolicy.section.sharing.summary\": \"Chúng tôi sử dụng các nhà cung cấp dịch vụ có phạm vi chặt chẽ để lưu trữ, bảo mật, email và hỗ trợ nền tảng — không phải để bán lại hoặc khai thác dữ liệu của bạn.\",\n    \"privacyPolicy.section.sharing.title\": \"Chia sẻ và các đơn vị xử lý\",\n    \"privacyPolicy.section.usage.b1\": \"Xác thực và bảo mật tài khoản của bạn\",\n    \"privacyPolicy.section.usage.b2\": \"Cung cấp huấn luyện AI và quy trình sản phẩm mà bạn sử dụng một cách rõ ràng\",\n    \"privacyPolicy.section.usage.b3\": \"Vận hành hỗ trợ, thanh toán, tuân thủ và giao tiếp tin cậy\",\n    \"privacyPolicy.section.usage.b4\": \"Phát hiện lạm dụng, giám sát sự cố và duy trì độ tin cậy\",\n    \"privacyPolicy.section.usage.p1\": \"Các mục sử dụng cốt lõi bao gồm tạo tài khoản, xác thực, quản lý đăng ký, cá nhân hóa nền tảng, cung cấp huấn luyện, lập lịch, hỗ trợ, ngăn chặn gian lận, phát hiện lạm dụng và phân tích dịch vụ. Mỗi mục sử dụng nên liên kết trở lại với một mục đích kinh doanh hoặc pháp lý hợp lệ.\",\n    \"privacyPolicy.section.usage.p2\": \"Khi sự đồng ý là cơ sở, bạn có thể rút lại. Khi việc thực hiện hợp đồng hoặc lợi ích hợp pháp là cơ sở, chúng tôi nhằm mục đích giải thích ý nghĩa của điều đó theo các điều khoản hoạt động để người dùng không bị bỏ lại trong sự đoán già đoán non.\",\n    \"privacyPolicy.section.usage.summary\": \"Chúng tôi sử dụng dữ liệu để cung cấp dịch vụ mà bạn đã yêu cầu, bảo vệ nền tảng và tuân thủ các nghĩa vụ pháp lý.\",\n    \"privacyPolicy.section.usage.title\": \"Cách chúng tôi sử dụng dữ liệu của bạn\",\n    \"privacyPolicy.sidebar.ctaBody\": \"Sử dụng lối đi yêu cầu tự phục vụ đã được xác minh của chúng tôi để xuất hoặc xóa, hoặc liên hệ với bộ phận quyền riêng tư để có thêm câu hỏi sâu.\",\n    \"privacyPolicy.sidebar.ctaButton\": \"Mở Quản lý Dữ liệu của Tôi\",\n    \"privacyPolicy.sidebar.ctaTitle\": \"Cần hành động?\",\n    \"privacyPolicy.sidebar.search\": \"Tìm kiếm chính sách này\",\n    \"privacyPolicy.sidebar.title\": \"Dẫn hướng chính sách\",\n    \"privacyPolicy.summary.title\": \"TL;DR — điều gì quan trọng nhất\",\n    \"privacyPolicy.table.collection.account\": \"Dữ liệu tài khoản\",\n    \"privacyPolicy.table.collection.accountValue\": \"Tên, email, cài đặt hồ sơ, trạng thái gói\",\n    \"privacyPolicy.table.collection.connected\": \"Dịch vụ liên kết\",\n    \"privacyPolicy.table.collection.connectedValue\": \"Sự kiện lịch, token OAuth, siêu dữ liệu danh tính hồ sơ\",\n    \"privacyPolicy.table.collection.product\": \"Sử dụng sản phẩm\",\n    \"privacyPolicy.table.collection.productValue\": \"Sử dụng tính năng, chẩn đoán lỗi, mẫu phiên\",\n    \"privacyPolicy.table.collection.support\": \"Hồ sơ hỗ trợ\",\n    \"privacyPolicy.table.collection.supportValue\": \"Phiếu yêu cầu, phản hồi, yêu cầu pháp lý/quyền riêng tư\",\n    \"privacyPolicy.table.retention.account\": \"Hồ sơ tài khoản\",\n    \"privacyPolicy.table.retention.accountValue\": \"Được lưu giữ trong khi hoạ