.goBack\": \"Quay Lại\",\n    \"scenario.alerts.errorTitle\": \"Lỗi\",\n    \"scenario.alerts.loadFailed\": \"Không thể tải kịch bản\",\n    \"scenario.alerts.startFailed\": \"Không thể khởi động phiên thực hành\",\n    \"scenario.alerts.waitForInit\": \"Vui lòng đợi trong khi chúng tôi khởi tạo phiên của bạn\",\n    \"scenario.errors.notFound\": \"Không tìm thấy kịch bản\",\n    \"scenario.page.detailsTitle\": \"Chi Tiết Kịch Bản\",\n    \"searchFeatures\": \"Tìm kiếm tính năng...\",\n    \"securityCenter.actionHub.open\": \"Dòng chảy mở\",\n    \"securityCenter.actionHub.subtitle\": \"Người dùng thường cần trang tin cậy liên kết tiếp theo ngay sau bảo mật — quyền riêng tư, GDPR, hoặc hỗ trợ — vì vậy những hành động đó sẽ được hiển thị tại đây.\",\n    \"securityCenter.actionHub.title\": \"Tiếp tục đánh giá độ tin cậy với bề mặt đúng\",\n    \"securityCenter.actions.gdpr.body\": \"Hiểu quyền, cơ sở hợp pháp và biện pháp bảo vệ chuyển nhượng.\",\n    \"securityCenter.actions.gdpr.title\": \"Xem lại quyền GDPR\",\n    \"securityCenter.actions.privacy.body\": \"Xem dữ liệu nào được thu thập, sử dụng, chia sẻ và lưu giữ.\",\n    \"securityCenter.actions.privacy.title\": \"Xem lại Chính sách Bảo mật\",\n    \"securityCenter.actions.support.body\": \"Thúc đẩy các câu hỏi về độ tin cậy, truy cập hoặc bảo mật thông qua Hỗ trợ & Giúp đỡ.\",\n    \"securityCenter.actions.support.title\": \"Liên hệ hỗ trợ\",\n    \"securityCenter.changelog.1\": \"Đưa phong thái bảo mật được tái định hình thành một bề mặt trung tâm tin cậy công cộng cao cấp.\",\n    \"securityCenter.changelog.2\": \"Kết nối các trang bảo mật, quyền riêng tư và GDPR thành một gia đình tin cậy pháp lý.\",\n    \"securityCenter.changelog.3\": \"Biến ngôn ngữ bảo mật công khai thành hoạt động hơn và ít chung chung hơn.\",\n    \"securityCenter.changelog.title\": \"Điều gì đã thay đổi trong trải nghiệm bảo mật này\",\n    \"securityCenter.contact.body\": \"Nếu bạn cần giúp đánh giá bảo mật sản phẩm, tư thế tin cậy hoặc các tuyên bố sẵn sàng xử lý sự cố, hãy liên hệ với quy trình hỗ trợ của chúng tôi và chúng tôi sẽ chuyển tiếp yêu cầu một cách thích hợp.\",\n    \"securityCenter.contact.privacy\": \"Các trang quyền riêng tư và GDPR vẫn liên kết cho việc theo dõi dựa trên quyền.\",\n    \"securityCenter.contact.status\": \"Tính tin cậy hoạt động cũng phụ thuộc vào việc giám sát và khôi phục liên tục.\",\n    \"securityCenter.contact.support\": \"Không gian Giúp & Hỗ trợ\",\n    \"securityCenter.contact.title\": \"Các câu hỏi về bảo mật, tin cậy hoặc rủi ro nền tảng\",\n    \"securityCenter.fact.encryption.body\": \"Bảo vệ vận chuyển, lưu trữ và xử lý mã thông báo hỗ trợ các quy trình nhạy cảm.\",\n    \"securityCenter.fact.encryption.title\": \"Các lớp mã hóa\",\n    \"securityCenter.fact.identity.body\": \"Kiểm soát xác thực, quyền truy cập đường dẫn và trạng thái tài khoản hoạt động cùng nhau.\",\n    \"securityCenter.fact.identity.title\": \"Danh tính & quyền truy cập\",\n    \"securityCenter.fact.operations.body\": \"Các thực tiễn giám sát, phản ứng và khôi phục củng cố lòng tin của người dùng.\",\n    \"securityCenter.fact.operations.title\": \"Phòng thủ hoạt động\",\n    \"securityCenter.fact.privacy.body\": \"Bảo mật vẫn liên kết với quyền riêng tư, thông báo pháp lý và luồng kiểm soát dữ liệu.\",\n    \"securityCenter.fact.privacy.title\": \"Liên tục tin cậy\",\n    \"securityCenter.hero.badge\": \"TRUNG TÂM TIN CẬY BẢO MẬT\",\n    \"securityCenter.hero.cta.contact\": \"Liên hệ với Bảo mật & Hỗ trợ\",\n    \"securityCenter.hero.cta.privacy\": \"Xem lại Cam kết về quyền riêng tư\",\n    \"securityCenter.hero.imageAlt\": \"Nền tảng cơ sở hạ tầng bảo mật trừu tượng\",\n    \"securityCenter.hero.meta.linkage\": \"Liên kết với các bề mặt tin cậy quyền riêng tư và GDPR\",\n    \"securityCenter.hero.meta.response\": \"Các quy trình sự cố hoạt động hỗ trợ phát hiện và khôi phục nhanh chóng\",\n    \"securityCenter.hero.meta.updated\": \"Cập nhật lần cuối: Ngày 20 tháng 3 năm 2026\",\n    \"securityCenter.hero.subtitle\": \"Trang này biến bảo mật nền tảng, độ tin cậy, sẵn sàng xử lý sự cố và kiểm soát tin cậy thành trải nghiệm bảo mật chất lượng có thể đọc được.\",\n    \"securityCenter.hero.title\": \"Tư thế bảo mật mà người dùng có thể hiểu trước khi họ tin tưởng chúng tôi với công việc.\",\n    \"securityCenter.hero.version\": \"Phiên bản 2026.2\",\n    \"securityCenter.section.compliance.p1\": \"Tư thế bảo mật của chúng tôi liên kết với quyền riêng tư, GDPR, bảo vệ tài khoản và quy trình thông báo pháp lý để người dùng không phải coi đây là những lời hứa tách biệt.\",\n    \"securityCenter.section.compliance.p2\": \"Điều này có nghĩa là các trang công khai tin cậy, các hành động yêu cầu quyền riêng tư và thông báo cập nhật chính sách có thể củng cố lẫn nhau thay vì tách rời theo thời gian.\",\n    \"securityCenter.section.compliance.summary\": \"Tư thế bảo mật mạnh mẽ nhất khi quyền riêng tư, tính minh bạch pháp lý và kiểm soát hoạt động vẫn được kết nối.\",\n    \"securityCenter.section.compliance.title\": \"Tuân thủ, quyền riêng tư và kiểm soát người dùng\",\n    \"securityCenter.section.encryption.p1\": \"Chúng tôi sử dụng các kiểm soát nhiều lớp như mã hóa vận chuyển, bảo vệ tại chỗ, quyền truy cập dựa trên vai trò, kiểm soát phiên và luồng xác thực được hỗ trợ bởi nhà cung cấp để giảm thiểu rủi ro truy cập trái phép.\",\n    \"securityCenter.section.encryption.p2\": \"Chính sách xác thực và quyền truy cập được liên kết với trạng thái tài khoản, kiểm soát quyền hạn và quy trình bảo mật thay vì chỉ dựa trên logic đăng nhập tách biệt.\",\n    \"securityCenter.section.encryption.summary\": \"Các bảo vệ cốt lõi cho thông tin xác thực, phiên, vận chuyển, lưu trữ và quyền truy cập đặc quyền.\",\n    \"securityCenter.section.encryption.title\": \"Mã hóa, xác thực và kiểm soát truy cập\",\n    \"securityCenter.section.focus\": \"Phần ghim\",\n    \"securityCenter.section.operations.b1\": \"Giám sát hoạt động và hỗ trợ cảnh báo phát hiện sớm sự cố\",\n    \"securityCenter.section.operations.b2\": \"Quy trình sự cố hỗ trợ containment, phục hồi và đánh giá\",\n    \"securityCenter.section.operations.b3\": \"Bề mặt bảo mật và quyền riêng tư vẫn liên kết với nhau để duy trì lòng tin của người dùng\",\n    \"securityCenter.section.operations.p1\": \"Giám sát, cảnh báo, kiểm tra hiệu suất, kiểm soát tình trạng đường đi và khả năng nhìn thấy kiểm toán đều góp phần vào tư thế bảo mật của chúng tôi. Bảo mật gắn liền với độ tin cậy vì sự cố sản phẩm im lặng cũng là vấn đề lòng tin.\",\n    \"securityCenter.section.operations.p2\": \"Khi sự cố xảy ra, chúng tôi nhắm đến phản hồi có tài liệu, containment hoạt động và các thực tiễn phục hồi minh bạch hơn là chỉ đơn giản là đảm bảo mơ hồ.\",\n    \"securityCenter.section.operations.summary\": \"Chúng tôi sử dụng giám sát nhiều lớp và các mẫu phản ứng hoạt động để phát hiện sự cố và phục hồi nhanh chóng.\",\n    \"securityCenter.section.operations.title\": \"Giám sát, phản ứng sự cố và hoạt động của nền tảng\",\n    \"securityCenter.section.posture.b1\": \"Tư thế bảo mật liên quan đến danh tính, truy cập đường đi, trạng thái kế hoạch và giám sát hoạt động\",\n    \"securityCenter.section.posture.b2\": \"Các tín hiệu lòng tin công cộng vẫn được kết nối với quyền riêng tư và các bề mặt quyền GDPR\",\n    \"securityCenter.section.posture.b3\": \"Các kiểm soát được thiết kế để có thể đọc hiểu đối với cả cá nhân và người đánh giá tuân thủ\",\n    \"securityCenter.section.posture.p1\": \"RealAICoach được xây dựng cho người dùng và các nhóm cần có hàng rào bảo vệ rõ ràng xung quanh truy cập, thanh toán, quyền riêng tư và lòng tin hoạt động. Bảo mật được coi như một lớp sản phẩm, không phải là một suy nghĩ sau cùng bị ẩn trong ngôn ngữ của nhà cung cấp.\",\n    \"securityCenter.section.posture.p2\": \"Trang bảo mật công cộng của chúng tôi được thiết kế để giúp người dùng đánh giá phương pháp của chúng tôi trước khi họ trở thành người dùng trả phí, và hỗ trợ các cuộc trò chuyện chuyên sâu mà không cần một quy trình bán hàng doanh nghiệp trước.\",\n    \"securityCenter.section.posture.summary\": \"Giải thích cách mà RealAICoach suy nghĩ về lòng tin nền tảng, khả năng phục hồi, kiểm soát truy cập và phòng thủ hoạt động.\",\n    \"securityCenter.section.posture.title\": \"Tư thế bảo mật và mô hình nền tảng\",\n    \"securityCenter.sidebar.ctaBody\": \"Chuyển vào Quyền riêng tư, GDPR, hoặc Trợ giúp tùy thuộc vào việc câu hỏi của bạn là pháp lý, hoạt động, hay dựa trên quyền.\",\n    \"securityCenter.sidebar.ctaButton\": \"Mở Trợ giúp & Hỗ trợ\",\n    \"securityCenter.sidebar.ctaTitle\": \"Cần theo dõi lòng tin?\",\n    \"securityCenter.sidebar.search\": \"Tìm kiếm các chủ đề bảo mật\",\n    \"securityCenter.sidebar.title\": \"Duyệt các chủ đề bảo mật\",\n    \"securityCenter.summary.title\": \"TL;DR — tư thế tin cậy đứng sau nền tảng\",\n    \"securityCenter.table.compliance.gdpr\": \"Liên kết GDPR\",\n    \"securityCenter.table.compliance.gdprValue\": \"Ngôn ngữ quyền GDPR và chuyển nhượng kết nối với tư thế bảo mật này\",\n    \"securityCenter.table.compliance.privacy\": \"Liên kết quyền riêng tư\",\n    \"securityCenter.table.compliance.privacyValue\": \"Các lộ trình quyền dữ liệu và quyền riêng tư vẫn được nhìn thấy\",\n    \"securityCenter.table.compliance.updates\": \"Sự liên tục thông báo pháp lý\",\n    \"securityCenter.table.compliance.updatesValue\": \"Các cập nhật chính sách và lòng tin có thể được thông báo qua các kênh sản phẩm/email phù hợp\",\n    \"securityCenter.table.encryption.access\": \"Kiểm soát truy cập\",\n    \"securityCenter.table.encryption.accessValue\": \"Thực thi truy cập phiên, vai trò và đường đi với giám sát\",\n    \"securityCenter.table.encryption.storage\": \"Ngừng hoạt động\",\n    \"securityCenter.table.encryption.storageValue\": \"Lưu trữ được mã hóa, bảo vệ bí mật và mã thông báo từ nhà cung cấp\",\n    \"securityCenter.table.encryption.transit\": \"Trong quá trình truyền\",\n    \"securityCenter.ta