e\": \"Xem lại quyền GDPR\",\n    \"cookieCenter.actions.privacy.body\": \"Xem cách hành vi cookie kết nối với việc thu thập dữ liệu, lưu giữ và quyền lợi.\",\n    \"cookieCenter.actions.privacy.title\": \"Xem lại Chính sách Bảo mật\",\n    \"cookieCenter.actions.request.body\": \"Xuất hoặc xóa dữ liệu cá nhân qua con đường bảo mật đã được xác minh.\",\n    \"cookieCenter.actions.request.title\": \"Mở quy trình yêu cầu quyền riêng tư\",\n    \"cookieCenter.changelog.1\": \"Xây dựng lại Chính sách Cookie vào cùng một gia đình Trung tâm Tin cậy như Bảo mật, Điều khoản, An toàn và GDPR.\",\n    \"cookieCenter.changelog.2\": \"Làm rõ sự khác biệt giữa tính liên tục phiên thiết yếu và lưu trữ tùy chọn.\",\n    \"cookieCenter.changelog.3\": \"Kết nối giải thích về cookie với quyền riêng tư và các bề mặt tin cậy pháp lý liên quan.\",\n    \"cookieCenter.changelog.title\": \"Những gì đã thay đổi trong trải nghiệm Chính sách Cookie này\",\n    \"cookieCenter.contact.body\": \"Nếu bạn cần giúp hiểu cách lưu trữ trình duyệt ảnh hưởng đến tài khoản, điều khiển quyền riêng tư, hoặc tính liên tục đăng nhập, hãy sử dụng các con đường bảo mật và hỗ trợ bên dưới.\",\n    \"cookieCenter.contact.policy\": \"Các Trung tâm Tin cậy về Bảo mật và GDPR vẫn liên kết để có ngữ cảnh đầy đủ về quyền lợi\",\n    \"cookieCenter.contact.privacy\": \"privacy@realaicoach.app\",\n    \"cookieCenter.contact.support\": \"Không gian Giúp & Hỗ trợ\",\n    \"cookieCenter.contact.title\": \"Câu hỏi về cookie, sự đồng ý hoặc trạng thái trình duyệt\",\n    \"cookieCenter.fact.consent.body\": \"Trạng thái trình duyệt liên quan đến sự đồng ý giúp chúng tôi tôn trọng các lựa chọn tin cậy trước đó.\",\n    \"cookieCenter.fact.consent.title\": \"Lưu trữ sự đồng ý\",\n    \"cookieCenter.fact.control.body\": \"Cài đặt trình duyệt và các luồng bảo mật mang lại cho bạn quyền kiểm soát có ý nghĩa về hành vi cookie.\",\n    \"cookieCenter.fact.control.title\": \"Quyền kiểm soát của người dùng\",\n    \"cookieCenter.fact.essential.body\": \"Một số lưu trữ trình duyệt là cần thiết cho việc đăng nhập, tính liên tục phiên và an toàn tài khoản.\",\n    \"cookieCenter.fact.essential.title\": \"Tính liên tục thiết yếu\",\n    \"cookieCenter.fact.preferences.body\": \"Chủ đề, ngôn ngữ và một số tùy chọn hiển thị dựa vào lưu trữ tùy chọn.\",\n    \"cookieCenter.fact.preferences.title\": \"Nhớ tùy chọn\",\n    \"cookieCenter.hero.badge\": \"TRUNG TÂM TIN CẬY COOKIE\",\n    \"cookieCenter.hero.cta.manage\": \"Quản lý Dữ liệu của tôi\",\n    \"cookieCenter.hero.cta.privacy\": \"Xem lại Chính sách Bảo mật\",\n    \"cookieCenter.hero.imageAlt\": \"Tóm tắt về bảo mật trình duyệt và nền tảng tùy chọn\",\n    \"cookieCenter.hero.meta.linkage\": \"Đã kết nối với các trang tin cậy về Quyền riêng tư, An ninh và GDPR\",\n    \"cookieCenter.hero.meta.scope\": \"Bao gồm cookie, lưu trữ trên trình duyệt và duy trì sở thích\",\n    \"cookieCenter.hero.meta.updated\": \"Cập nhật lần cuối: Ngày 20 tháng 3 năm 2026\",\n    \"cookieCenter.hero.subtitle\": \"Trang này giải thích công nghệ cấp trình duyệt giúp bảo vệ phiên, duy trì sở thích và hiểu rõ các lựa chọn tin cậy trên nền tảng.\",\n    \"cookieCenter.hero.title\": \"Chính sách Cookie giải thích rõ ràng các sự đánh đổi, không chỉ là cơ chế đồng ý.\",\n    \"cookieCenter.hero.version\": \"Phiên bản 2026.2\",\n    \"cookieCenter.section.controls.b1\": \"Sử dụng các tùy chọn trên trình duyệt để xóa hoặc chặn cookie đã lưu\",\n    \"cookieCenter.section.controls.b2\": \"Sử dụng cài đặt nền tảng và các lối đi về quyền riêng tư cho các sở thích liên quan đến chủ đề/ngôn ngữ hoặc đồng ý\",\n    \"cookieCenter.section.controls.b3\": \"Xem lại Chính sách Quyền riêng tư và các trang GDPR để hiểu các tác động về quyền dữ liệu liên quan\",\n    \"cookieCenter.section.controls.p1\": \"Bạn thường có thể xem, chặn hoặc xóa cookie thông qua cài đặt trình duyệt của mình. Bạn cũng có thể quản lý một số sở thích cấp nền tảng trực tiếp thông qua cài đặt sản phẩm hoặc bề mặt kiểm soát quyền riêng tư.\",\n    \"cookieCenter.section.controls.p2\": \"Việc chặn các cookie thiết yếu có thể ảnh hưởng đến việc đăng nhập, duy trì lộ trình, định vị hoặc quy trình bảo mật. Do đó, chúng tôi giải thích các hậu quả thay vì trình bày các kiểm soát cookie như là các công tắc không có hậu quả.\",\n    \"cookieCenter.section.controls.summary\": \"Người dùng có thể kiểm soát cookie thông qua cài đặt trình duyệt và bề mặt sở thích nền tảng, mặc dù việc chặn một số loại có thể thay đổi hành vi sản phẩm.\",\n    \"cookieCenter.section.controls.title\": \"Cách bạn có thể quản lý cookie và sở thích\",\n    \"cookieCenter.section.focus\": \"Phần ghim\",\n    \"cookieCenter.section.overview.b1\": \"Bao gồm cookie, lưu trữ cục bộ và dữ liệu trình duyệt liên quan đến sở thích\",\n    \"cookieCenter.section.overview.b2\": \"Tách biệt sự liên tục của dịch vụ thiết yếu với việc sử dụng sở thích hoặc đo lường tùy chọn\",\n    \"cookieCenter.section.overview.b3\": \"Kết nối các giải thích về cookie với các bề mặt về quyền riêng tư và tin cậy pháp lý\",\n    \"cookieCenter.section.overview.p1\": \"Cookie và các công nghệ lưu trữ trên trình duyệt tương tự giúp RealAICoach giữ cho các phiên giao dịch an toàn, nhớ sở thích đã chọn, duy trì sự liên tục về ngôn ngữ và chủ đề, và hiểu hành vi dịch vụ tổng hợp.\",\n    \"cookieCenter.section.overview.p2\": \"Chúng tôi cố gắng giải thích cookie theo cách thực tiễn để người dùng có thể hiểu những gì là thiết yếu cho dịch vụ hoạt động, những gì là tùy chọn và cách kiểm soát cấp trình duyệt ảnh hưởng đến trải nghiệm sản phẩm.\",\n    \"cookieCenter.section.overview.summary\": \"Giải thích rõ ràng về cách cookie, lưu trữ cục bộ và sở thích thiết bị hỗ trợ xác thực, tính khả dụng và sự liên tục tin cậy.\",\n    \"cookieCenter.section.overview.title\": \"Cookie là gì và tại sao chúng tồn tại\",\n    \"cookieCenter.section.thirdParty.p1\": \"Khi cơ sở hạ tầng của bên thứ ba, thanh toán, phân tích hoặc nhà cung cấp dịch vụ liên kết được sử dụng, họ có thể thiết lập hoặc dựa vào lưu trữ trình duyệt theo vai trò hoạt động hạn chế của họ. Chúng tôi nhằm tránh các chuỗi phụ thuộc ẩn hoặc không được giải thích.\",\n    \"cookieCenter.section.thirdParty.p2\": \"Các dịch vụ liên kết như các trải nghiệm liên kết với Google luôn nên được hiểu cùng với Chính sách Quyền riêng tư, vì cookie và mã xác thực có thể hoạt động cùng nhau để duy trì quy trình làm việc đã xác thực.\",\n    \"cookieCenter.section.thirdParty.summary\": \"Một số nhà cung cấp dịch vụ bên thứ ba và trải nghiệm kết nối có thể dựa vào lưu trữ do chính họ kiểm soát hoặc hành vi liên quan đến đồng ý.\",\n    \"cookieCenter.section.thirdParty.title\": \"Các tác động của bên thứ ba và dịch vụ kết nối\",\n    \"cookieCenter.section.types.p1\": \"Một số cookie là thiết yếu cho việc đăng nhập, duy trì phiên của bạn và bảo vệ nền tảng. Những cookie khác giúp nhớ cài đặt như ngôn ngữ và chủ đề. Một số công cụ phân tích hoặc sở thích hạn chế cũng có thể dựa vào lưu trữ trình duyệt.\",\n    \"cookieCenter.section.types.p2\": \"Chúng tôi cố gắng giữ việc sử dụng cookie phù hợp và có thể giải thích để Chính sách Cookie vẫn hữu ích cho người dùng thực thay vì trở thành một phụ lục kỹ thuật mà không ai có thể hành động.\",\n    \"cookieCenter.section.types.summary\": \"Các loại xác thực, sở thích, đồng ý và đo lường hạn chế phục vụ các mục đích khác nhau.\",\n    \"cookieCenter.section.types.title\": \"Các loại cookie mà chúng tôi sử dụng\",\n    \"cookieCenter.sidebar.ctaBody\": \"Các kiểm soát cookie giải thích hành vi của trình duyệt, nhưng quyền riêng tư và yêu cầu dữ liệu nằm trong Trung tâm Tin cậy về Quyền riêng tư và quy trình quyền riêng tư.\",\n    \"cookieCenter.sidebar.ctaButton\": \"Mở Trung tâm Niềm tin Riêng tư\",\n    \"cookieCenter.sidebar.ctaTitle\": \"Cần xem toàn bộ dữ liệu không?\",\n    \"cookieCenter.sidebar.search\": \"Tìm kiếm Chính sách Cookie\",\n    \"cookieCenter.sidebar.title\": \"Duyệt các chủ đề cookie\",\n    \"cookieCenter.summary.title\": \"TL;DR — cookie có nghĩa là gì ở đây\",\n    \"cookieCenter.table.thirdParty.connected\": \"Dịch vụ liên kết\",\n    \"cookieCenter.table.thirdParty.connectedValue\": \"Một số quy trình làm việc kết nối có thể ghép trạng thái trình duyệt với trạng thái ủy quyền của nhà cung cấp\",\n    \"cookieCenter.table.thirdParty.infrastructure\": \"Cơ sở hạ tầng\",\n    \"cookieCenter.table.thirdParty.infrastructureValue\": \"Hỗ trợ lưu trữ, liên tục phiên và độ tin cậy\",\n    \"cookieCenter.table.thirdParty.payments\": \"thanh toán\",\n    \"cookieCenter.table.thirdParty.paymentsValue\": \"Các bộ xử lý thanh toán và lập hóa đơn có thể dựa vào trình duyệt/nhà liên tục\",\n    \"cookieCenter.table.types.consent\": \"Lưu trữ sự đồng ý\",\n    \"cookieCenter.table.types.consentValue\": \"Lưu trạng thái đồng ý riêng tư/cookie và các lựa chọn niềm tin liên quan\",\n    \"cookieCenter.table.types.measurement\": \"Đo lường dịch vụ\",\n    \"cookieCenter.table.types.measurementValue\": \"Giúp chúng tôi hiểu cách sử dụng dịch vụ tổng hợp và các mẫu độ tin cậy\",\n    \"cookieCenter.table.types.preferences\": \"Tùy chọn\",\n    \"cookieCenter.table.types.preferencesValue\": \"Nhớ chủ đề, ngôn ngữ và sở thích hiển thị đã chọn\",\n    \"cookieCenter.table.types.session\": \"Phiên/xác thực\",\n    \"cookieCenter.table.types.sessionValue\": \"Hỗ trợ liên tục đăng nhập, truy cập đường dẫn và trạng thái phiên đã xác minh\",\n    \"cookieCenter.trustPanel.item1\": \"Bạn có thể hiểu điều gì sẽ xảy ra nếu các cookie thiết yếu bị chặn.\",\n    \"cookieCenter.trustPanel.item2\": \"Lưu trữ sở thích được giải thích theo cách dễ hiểu hơn là bị chôn vùi trong ngôn ngữ pháp lý.\",\n    \"cookieCenter.trustPanel.item3\": \"Hiểu biết về cookie giờ đây liên kết rõ ràng đến các trang quyền riêng tư và GDPR.\",\n    \"cookieCenter.trustPanel.title\": \"Điều này có nghĩa là gì đối với bạn\",\n    \"currencySelector.labels.current\": \"Tiền tệ hiện tại\",\n    \"currencySelector.page