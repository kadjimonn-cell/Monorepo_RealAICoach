ons.delete.body\": \"Doğrulanmış silme sürecini başlatın ve gizlilik işlemleri aracılığıyla tamamlanma güncellemeleri alın.\",\n    \"gdprCenter.actions.delete.title\": \"Kişisel verileri sil\",\n    \"gdprCenter.actions.export.body\": \"Doğrulanmış gizlilik akışı aracılığıyla makine okunabilir bir çıktı talep edin.\",\n    \"gdprCenter.actions.export.title\": \"Kişisel verileri dışa aktar\",\n    \"gdprCenter.actions.privacy.body\": \"GDPR'ye özgü haklardan Tam Gizlilik Güven Merkezi'ne geçiş yapın.\",\n    \"gdprCenter.actions.privacy.title\": \"Gizlilik Politikasını gözden geçirin\",\n    \"gdprCenter.changelog.1\": \"GDPR haklarını daha net kullanıcı ve operatör diline yeniden yapılandırıldı.\",\n    \"gdprCenter.changelog.2\": \"Yasal temel ve saklama açıklamalarını canlı ürün akışlarına bağladı.\",\n    \"gdprCenter.changelog.3\": \"GDPR'yi Güven Merkezi ailesi ve gizlilik talep işlemleri ile birleştirdi.\",\n    \"gdprCenter.changelog.title\": \"Bu GDPR deneyiminde ne değişti\",\n    \"gdprCenter.contact.body\": \"Haklar hakkında bir açıklamaya ihtiyacınız varsa, işlenmeye itiraz etmek istiyorsanız veya bir denetim makamı için belgelenmiş bir yanıt gerekiyorsa, aşağıdaki gizlilik yolunu kullanın.\",\n    \"gdprCenter.contact.help\": \"Yardım ve Destek çalışma alanı\",\n    \"gdprCenter.contact.privacy\": \"privacy@realaicoach.app\",\n    \"gdprCenter.contact.request\": \"Dışa aktarma veya silme için doğrulanmış gizlilik talep iş akışı\",\n    \"gdprCenter.contact.title\": \"GDPR soruları, itirazlar veya otorite yükseltmeleri\",\n    \"gdprCenter.fact.lawful.body\": \"Sözleşme, meşru çıkar, onay ve yasal yükümlülük iş akışına bağlı olarak geçerlidir.\",\n    \"gdprCenter.fact.lawful.title\": \"Yasal temel\",\n    \"gdprCenter.fact.retention.body\": \"Veri, yalnızca hizmet, güvenlik veya yasal yükümlülükler için gerekli olduğu sürece saklanır.\",\n    \"gdprCenter.fact.retention.title\": \"Saklama netliği\",\n    \"gdprCenter.fact.rights.body\": \"Erişim, düzeltme, silme, taşınabilirlik, itiraz ve kısıtlama yolları mevcuttur.\",\n    \"gdprCenter.fact.rights.title\": \"Mevcut haklar\",\n    \"gdprCenter.fact.transfer.body\": \"Sınır ötesi işleme, sözleşmesel ve teknik koruma katmanlarına dayanır.\",\n    \"gdprCenter.fact.transfer.title\": \"Aktarım önlemleri\",\n    \"gdprCenter.hero.badge\": \"GDPR GÜVEN MERKEZİ\",\n    \"gdprCenter.hero.cta.contact\": \"Gizlilik Ekibi ile İletişime Geç\",\n    \"gdprCenter.hero.cta.manage\": \"Verilerimi Yönet\",\n    \"gdprCenter.hero.imageAlt\": \"Soyut sınır ötesi veri ve uyum arka planı\",\n    \"gdprCenter.hero.meta.effective\": \"Geçerli: 20 Mart 2026\",\n    \"gdprCenter.hero.meta.sla\": \"Gizlilik operasyonları hedefi: 72 saat içinde ilk yanıt\",\n    \"gdprCenter.hero.meta.updated\": \"Son güncelleme: 20 Mart 2026\",\n    \"gdprCenter.hero.subtitle\": \"Bu sayfa, GDPR haklarını, yasal temeli, saklama ve aktarım dilini kullanıcılar ve gözden geçiriciler için gerçek bir güven ve eylem yüzeyine dönüştürüyor.\",\n    \"gdprCenter.hero.title\": \"GDPR, yalnızca yasal etiketler değil, operasyonel terimlerle açıklanmaktadır.\",\n    \"gdprCenter.hero.version\": \"Sürüm 2026.2\",\n    \"gdprCenter.section.controller.b1\": \"EEA/İngiltere veri hakları ve ilgili güven yükümlülüklerine uygulanır\",\n    \"gdprCenter.section.controller.b2\": \"Yasal hakları gerçek ürün ve destek iş akışlarına bağlar\",\n    \"gdprCenter.section.controller.b3\": \"Hem kullanıcıların hem de uyum gözden geçiricilerinin sistemi hızlı bir şekilde anlamalarına yardımcı olmak için oluşturulmuştur.\",\n    \"gdprCenter.section.controller.p1\": \"RealAICoach platform hesabı, ürün, destek ve bağlantılı hizmet verilerini işleme amaçlarını ve yollarını belirlediğimiz ölçüde bir denetleyici olarak hareket eder. Bazı işleyiciler sözleşmeye dayalı kontrol altında talimatlarımız üzerine hareket eder.\",\n    \"gdprCenter.section.controller.p2\": \"Bu sayfa, erişim, düzeltme, silme, taşınabilirlik, itiraz, kısıtlama ve gizlilik iletişim yolları için GDPR ile ilgili taahhütlerimizi geleneksel bir yasal nottan daha pratik bir formatta özetlemektedir.\",\n    \"gdprCenter.section.controller.summary\": \"Denetleyici olarak rolümüzü, hangi veri kategorilerinin kapsamda olduğunu ve neden GDPR'nın geçerli olduğunu açıklar.\",\n    \"gdprCenter.section.controller.title\": \"Denetleyici, kapsam ve yasal çerçeve\",\n    \"gdprCenter.section.focus\": \"Pin bölümü\",\n    \"gdprCenter.section.lawful.p1\": \"Temel yasal dayanaklarımız veri kategorisi ve ilgili iş akışına bağlı olarak sözleşme icrası, meşru menfaat, rıza ve yasal yükümlülüktür.\",\n    \"gdprCenter.section.lawful.p2\": \"Rıza kullanıldığında, kullanıcılar bunu geri çekebilir. Meşru menfaat kullanıldığında, işleme oranlı, açıklanabilir ve belirtilen operasyonel ihtiyaç ile sınırlı olması hedeflenmektedir.\",\n    \"gdprCenter.section.lawful.summary\": \"Kişisel veriler yalnızca meşru bir dayanak amaca destekliyorsa işlenir.\",\n    \"gdprCenter.section.lawful.title\": \"İşleme için yasal dayanak\",\n    \"gdprCenter.section.rights.b1\": \"Doğrulanmış gizlilik talep portalı aracılığıyla dışa aktarın veya silin\",\n    \"gdprCenter.section.rights.b2\": \"Düzeltme, itiraz veya kısıtlama talepleri için gizlilik ekibi ile iletişime geçin\",\n    \"gdprCenter.section.rights.b3\": \"Yasal olarak gerekli olduğunda bir denetleyici otoriteye başvurun\",\n    \"gdprCenter.section.rights.p1\": \"Kullanıcılar, kişisel verilere erişim, yanlış verilerin düzeltilmesi, izin verilen durumlarda silme, taşınabilirlik, kısıtlama, itiraz ve rıza ile ilgili tercihlerin gözden geçirilmesini talep edebilir. Ayrıca dışa aktarım ve silme doğrulaması için kendi kendine hizmet yolu sağlıyoruz.\",\n    \"gdprCenter.section.rights.p2\": \"Bir talep tam olarak gönderildiği şekilde tamamlanamadığında, nedenini, hangi yasal veya operasyonel sınırlamanın geçerli olduğunu ve hangi alternatif yolun mevcut olduğunu açıklamayı hedefliyoruz.\",\n    \"gdprCenter.section.rights.summary\": \"Erişim, düzeltme, silme, taşınabilirlik, itiraz, kısıtlama ve rıza geri çekme, gerçek talep akışlarıyla bağlantılıdır.\",\n    \"gdprCenter.section.rights.title\": \"GDPR haklarınız\",\n    \"gdprCenter.section.transfers.p1\": \"Kişisel veriler EEA veya Birleşik Krallık dışında işlendiğinde, işlem bağlamına uygun sözleşmeye dayalı korumalar, sağlayıcı yükümlülükleri ve güvenlik kontrolleri gibi uygun korumalara dayanmaktayız.\",\n    \"gdprCenter.section.transfers.p2\": \"Veri saklama, ürün gerekliliği, yasal yükümlülük, güvenlik ihtiyaçları ve doğrulanmış silme taleplerine bağlıdır. Saklama süresini anlaşılır kılmak, belirsiz yasal genel bilgiler içinde gizli tutmaktan daha önemlidir.\",\n    \"gdprCenter.section.transfers.summary\": \"Sınır ötesi işleme ve saklama, sözleşmeye dayalı, teknik ve operasyonel korumalarla kontrol edilir.\",\n    \"gdprCenter.section.transfers.title\": \"Uluslararası transferler, saklama ve korumalar\",\n    \"gdprCenter.sidebar.ctaBody\": \"Dışa aktarım veya silme için doğrulanmış gizlilik talep yolunu kullanın veya daha spesifik GDPR talepleri için gizlilik operasyonları ile iletişime geçin.\",\n    \"gdprCenter.sidebar.ctaButton\": \"Açık gizlilik talep akışı\",\n    \"gdprCenter.sidebar.ctaTitle\": \"Bir hakkı kullanmak mı gerekiyor?\",\n    \"gdprCenter.sidebar.search\": \"GDPR konularını arayın\",\n    \"gdprCenter.sidebar.title\": \"GDPR konularında gezin\",\n    \"gdprCenter.summary.title\": \"TL;DR — bu platformdaki GDPR durumunuz\",\n    \"gdprCenter.table.lawful.consent\": \"Rıza\",\n    \"gdprCenter.table.lawful.consentValue\": \"Opsiyonel iletişimler, bazı bağlantılı özellikler ve tercih odaklı kontroller\",\n    \"gdprCenter.table.lawful.contract\": \"Sözleşme\",\n    \"gdprCenter.table.lawful.contractValue\": \"Açık hesaplar, abonelikler, destek ve ürün iş akışları\",\n    \"gdprCenter.table.lawful.legal\": \"Yasal yükümlülük\",\n    \"gdprCenter.table.lawful.legalValue\": \"Denetim, vergi, güvenlik v