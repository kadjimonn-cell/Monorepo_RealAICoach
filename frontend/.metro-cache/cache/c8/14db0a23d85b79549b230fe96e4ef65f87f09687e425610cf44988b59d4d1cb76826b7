unapokuwa\\\\\",\n    \"pricing.tier.basic.audience\": \"Wafanya kazi na timu ndogo wanaojenga tabia za kudumu.\",\n    \"pricing.tier.basic.badge\": \"Kupendekezwa\",\n    \"pricing.tier.basic.emphasis\": \"Inalinganisha udhibiti wa gharama, uzalishaji, na kujiamini kwa kuboresha.\",\n    \"pricing.tier.basic.feature4\": \"Uthibitisho wa thamani wazi kwa mapitio ya kila wiki\",\n    \"pricing.tier.basic.rollout\": \"Inafaa sana kwa wasimamizi wanaohitaji matokeo ya kila wiki yanayoonekana.\",\n    \"pricing.tier.basic.subtitle\": \"Kiwango kinachofanya kazi kwa timu zinazojenga utekelezaji wa kila wiki.\",\n    \"pricing.tier.basic.support\": \"Msaada wa barua pepe\",\n    \"pricing.tier.basic.valueLabel\": \"Fanya kazi\",\n    \"pricing.tier.free.audience\": \"Watu binafsi wanathibitisha ufaa na mwendo wa mapema.\",\n    \"pricing.tier.free.emphasis\": \"Inafaa kwa kuthibitisha thamani kabla ya kuweka viwango vya kazi.\",\n    \"pricing.tier.free.feature4\": \"Misingi inayoweza kuzinduliwa\",\n    \"pricing.tier.free.rollout\": \"Washa haraka bila vizuizi vya ununuzi.\",\n    \"pricing.tier.free.subtitle\": \"Anza haraka na uwezo wa msingi na njia safi ya kuboresha.\",\n    \"pricing.tier.free.support\": \"Msaada wa jamii\",\n    \"pricing.tier.free.valueLabel\": \"Uzinduzi\",\n    \"pricing.tier.premium.audience\": \"Viongozi na watumiaji wenye nguvu wanaendesha michakato yenye uwajibikaji mkubwa.\",\n    \"pricing.tier.premium.badge\": \"Inayoweza zaidi\",\n    \"pricing.tier.premium.emphasis\": \"Kwa timu zinahitaji kina, kasi, na uaminifu mzuri wa kexecutive.\",\n    \"pricing.tier.premium.feature4\": \"Kufunika shughuli za hali ya juu kwa matumizi yaliyopanuliwa\",\n    \"pricing.tier.premium.rollout\": \"Imeundwa kwa ajili ya matumizi makubwa na mahitaji ya majibu ya haraka.\",\n    \"pricing.tier.premium.subtitle\": \"Kina cha kiwango cha biashara kwa viongozi, watumiaji wenye nguvu, na kazi zenye hatari kubwa.\",\n    \"pricing.tier.premium.support\": \"Msaada wa kipaumbele\",\n    \"pricing.tier.premium.valueLabel\": \"Harakisha\",\n    \"pricing.title\": \"Bei\",\n    \"pricing.yearly\": \"Kila mwaka\",\n    \"pricing.yearlyPeriod\": \"YearlyPeriod\",\n    \"privacyPolicy.actionHub.open\": \"Mtiririko wazi\",\n    \"privacyPolicy.actionHub.subtitle\": \"Mtiririko wetu wa shughuli za faragha umeundwa ili watumiaji halisi waweze kuchukua hatua mara moja: kusafirisha data, kuomba kufutwa, hak права, au kuwasiliana na timu ya faragha huku muktadha ukiwa tayari umeunganishwa.\",\n    \"privacyPolicy.actionHub.title\": \"Endesha data zako bila kufungua tiketi ya usaidizi kwanza\",\n    \"privacyPolicy.actions.delete.body\": \"Sukuma mchakato wa kufutwa uliothibitishwa kwa akaunti na rekodi zinazohusishwa za faragha.\",\n    \"privacyPolicy.actions.delete.title\": \"Futa data zangu\",\n    \"privacyPolicy.actions.export.body\": \"Omba nakala inayoweza kusomwa na mashine ya rekodi za akaunti yako, usaidizi, na shughuli za jukwaa.\",\n    \"privacyPolicy.actions.export.title\": \"Safirisha Data Yangu\",\n    \"privacyPolicy.actions.help.body\": \"Pandisha ombi la faragha, idhini, uhifadhi, au ufafanuzi wa kisheria kwa timu yetu ya shughuli.\",\n    \"privacyPolicy.actions.help.title\": \"Wasiliana na timu ya faragha\",\n    \"privacyPolicy.changelog.1\": \"Iliyofafanuliwa kushughulikia data zinazohusiana na Google na wajibu wa matumizi ya kikomo.\",\n    \"privacyPolicy.changelog.2\": \"Kupanuliwa kwa dirisha la uhifadhi na maelezo ya mchakato wa kufutwa kwa ombi za kujihudumia.\",\n    \"privacyPolicy.changelog.3\": \"Imeongeza njia wazi ya shughuli za faragha kwa ajili ya kusafirisha, kufuta, na kuongeza ombi.\",\n    \"privacyPolicy.changelog.title\": \"Nini kimebadilika katika toleo hili\",\n    \"privacyPolicy.contact.body\": \"Ikiwa unahitaji msaada wa kutafsiri sera hii, unataka kupandisha wasiwasi wa faragha, au unahitaji majibu yaliyoandikwa kwa ajili ya tathmini ya uzito, wasiliana na timu yetu ya shughuli za faragha au tumia njia ya ombi ya kujihudumia.\",\n    \"privacyPolicy.contact.email\": \"privacy@realaicoach.app\",\n    \"privacyPolicy.contact.help\": \"Mahali pa Msaada & Uungwaji\",\n    \"privacyPolicy.contact.sla\": \"Lengo la majibu ya kwanza: masaa 72\",\n    \"privacyPolicy.contact.title\": \"Maswali, malalamiko, au matangazo ya kisheria\",\n    \"privacyPolicy.fact.collect.body\": \"Ni akaunti tu, ukocha, usaidizi, na data ya huduma zinazohusiana zinazohitajika kuendesha jukwaa.\",\n    \"privacyPolicy.fact.collect.title\": \"Nini tunakusanya\",\n    \"privacyPolicy.fact.rights.body\": \"Safirisha, futa, rekebisha, pingamizi, au wasiliana na timu ya faragha kutoka njia moja ya kujihudumia.\",\n    \"privacyPolicy.fact.rights.title\": \"Madaraja yako\",\n    \"privacyPolicy.fact.share.body\": \"Wasiwezi kudhibitiwa tu — kamwe hayauzwi, kamwe hayashirikiwa kwa matangazo ya wahusika wengine, kamwe hayatumiki kwa mafunzo ya modeli kutoka kwa data za mtumiaji wa Google.\",\n    \"privacyPolicy.fact.share.title\": \"Nani anaona\",\n    \"privacyPolicy.fact.use.body\": \"Ili kukuthibitisha, kubinafsisha ukocha, shughuli za usaidizi, bili, na usalama wa jukwaa.\",\n    \"privacyPolicy.fact.use.title\": \"Jinsi tunavyotumia\",\n    \"privacyPolicy.hero.badge\": \"KITUO CHA UAMINIFU WA FARAGHA\",\n    \"privacyPolicy.hero.cta.contact\": \"Wasiliana na Timu ya Faragha\",\n    \"privacyPolicy.hero.cta.manage\": \"Dhibiti Data Yangu\",\n    \"privacyPolicy.hero.imageAlt\": \"Muktadha wa mtiririko wa data uliogongwa\",\n    \"privacyPolicy.hero.meta.effective\": \"Kuanza: Machi 18, 2026\",\n    \"privacyPolicy.hero.meta.response\": \"SLA ya operesheni za faragha: masaa 72 kwa majibu ya kwanza\",\n    \"privacyPolicy.hero.meta.updated\": \"Imesasishwa mwisho: Machi 18, 2026\",\n    \"privacyPolicy.hero.subtitle\": \"Orodha hii inaeleza kile tunachokusanya, kwa nini tunakusanya, muda tunaoifadhi, na unachoweza kufanya kuhusu hilo — bila kukulazimisha kufasiri maandiko ya kisheria kwanza.\",\n    \"privacyPolicy.hero.title\": \"Sera ya Faragha iliyoundwa kwa ajili ya uaminifu, hatua, na uwazi.\",\n    \"privacyPolicy.hero.version\": \"Toleo 2026.3\",\n    \"privacyPolicy.section.collection.p1\": \"Taarifa inaweza kuja moja kwa moja kutoka kwako, moja kwa moja kutoka matumizi ya jukwaa, au kutoka kwa watoa huduma waliounganishwa unaowekea ruksa. Makundi ya data yanajumuisha maelezo ya usajili, hali ya usajili, rekodi za msaada, muktadha wa mazungumzo ya AI, telemetry ya bidhaa, na kumbukumbu za usalama za kisheria.\",\n    \"privacyPolicy.section.collection.p2\": \"Katika uzoefu uliofadhiliwa na Google, tunapunguza ufikiaji kwa data ya chini inayohitajika kwa ajili ya usawazishaji wa kalenda, muktadha wa upangaji, na utambulisho wa akaunti. Data za mtumiaji wa Google hazitumiwi kwa matangazo na hazitumiwi kufundisha mifano ya AI ya jumla.\",\n    \"privacyPolicy.section.collection.summary\": \"Tunakusanya tu taarifa zinazohitajika kuendesha akaunti yako, mipangilio ya mafunzo, msaada, usalama, na wajibu wa kufuata.\",\n    \"privacyPolicy.section.collection.title\": \"Data tunayoikusanya\",\n    \"privacyPolicy.section.focus\": \"Sehemu ya pini\",\n    \"privacyPolicy.section.overview.b1\": \"Inatumika kwa wageni wa umma, watumiaji waliojiandikisha, wanachama wa kulipwa, na mwingiliano wa msaada\",\n    \"privacyPolicy.section.overview.b2\": \"Inaeleza data ya jukwaa, data iliyounganishwa na Google, rekodi za msaada, na telemetry ya operesheni\",\n    \"privacyPolicy.section.overview.b3\": \"Inaleta moja kwa moja haki za huduma binafsi na njia za maombi\",\n    \"privacyPolicy.section.overview.p1\": \"Sera hii ya Faragha inaeleza jinsi RealAICoach inakusanya, inatumia, inahifadhi, inalinda, na inafuta taarifa za kibinafsi kwenye tovuti zetu, programu, mifumo ya msaada, shughuli za bili, zana za mafunzo ya AI, na uunganisho na vyama vya tatu.\",\n    \"privacyPolicy.section.overview.p2\": \"Inatumika kwa wageni, watumiaji waliojiandikisha, wanachama, waombaji wa msaada, na watu wanaounganisha huduma kama Google ili kuwezesha kupanga na michakato ya uzalishaji. Tunajaribu kufanya sera hii kueleweka kabla haijawa tu ya kina.\",\n    \"privacyPolicy.section.overview.summary\": \"Muhtasari wa kisasa wa kile ambacho sera hii inashughulikia na wakati inatumika.\",\n    \"privacyPolicy.section.overview.title\": \"Muonekano na upeo\",\n    \"privacyPolicy.section.retention.p1\": \"Tunahifadhi makundi tofauti ya data kwa muda tofauti kulingana na hali ya akaunti, wajibu wa kisheria, majukumu ya usalama, na ikiwa umeomba kufutwa. Hifadhi za huduma zilizounganishwa zinaondolewa kwa nguvu zaidi kuliko rekodi za msingi za akaunti.\",\n    \"privacyPolicy.section.retention.p2\": \"Maombi ya kufuta yanathibitishwa kabla ya kutekelezwa. Rekodi zingine zinaweza kuhifadhiwa kwa muda mrefu ikiwa ni muhimu kwa kuzuia udanganyifu, marekebisho ya bili, mahitaji ya ukaguzi, au ulinzi wa migogoro, lakini tunajaribu kurekodi wazi mipaka hiyo.\",\n    \"privacyPolicy.section.retention.summary\": \"Madirisha ya uhifadhi yapo ili bidhaa ifanye kazi, wajibu wa kisheria kutimizwe, na data za kibinafsi zisipokaa milele.\",\n    \"privacyPolicy.section.retention.title\": \"Uhifadhi, kufuta, na uhifadhi\",\n    \"privacyPolicy.section.rights.b1\": \"Tumia mchakato wa Dhibiti Data Yangu kwa ajili ya usafirishaji au uthibitisho wa kufuta\",\n    \"privacyPolicy.section.rights.b2\": \"Ondoa uunganisho katika mipangilio ili kuzuiya usawazishaji wa huduma zilizounganishwa katika siku zijazo\",\n    \"privacyPolicy.section.rights.b3\": \"Wasiliana na privacy@realaicoach.app kwa maswali au rufaa zinazohusiana na mamlaka\",\n    \"privacyPolicy.section.rights.p1\": \"Kulingana na mamlaka yako, unaweza kuwa na haki za kufikia, kurekebisha, kufuta, kusafirisha, kuzuia, au kupinga usindikaji wa data zako za kibinafsi. Pia tunatoa njia za kudhibiti kibali, kuondoa uunganisho, na kuwasiliana na timu yetu ya operesheni za faragha.\",\n    \"privacyPolicy.section.rights.p2\": \"Lengo letu ni kufanya haki kuwa za vitendo, sio za ishara. Ndiyo maana ukurasa huu unahusisha moja kwa moja na hatua za huduma binafsi na njia za kupeleka msaada badala ya kulazimisha watumiaji kufafanua lugha ya kisheria peke yao.\",\n    \"privacyPolicy.section.rights.summary\": \"Unaweza kuomba ufikiaji, marekebisho, usafirishaji, kufutwa, vizuizi, pingamizi, au kujiondoa kwa ridhaa yako ukitumia njia zetu za faragha.\",\n    \"privacyPolicy.section.rights.title\": \"Haki na udhibiti wako\",\n    \"privacyPolicy.section.sharing.p1\": \"Tunaweza kushiriki habari na watoa huduma wa miundombinu, huduma za barua pepe za kibiashara, zana za uchambuzi au ufuatiliaji, na processors za malipo kwa nia ya kufanya kazi ya jukwaa. Kila processor ina mipaka ya kudhibiti kisheria na kiufundi.\",\n    \"privacyPolicy.section.sharing.p2\": \"Hat jualizi taarifa za kibinafsi. Hatushiriki data za mtumiaji wa Google na watangazaji, wanadai, au wahusika wa nje wasiohusika. Tunalenga kufichua ushirikiano kwa kundi ili ukurasa huu ubaki na manufaa kwa watumiaji halisi na waangalizi wa kufuata sheria.\",\n    \"privacyPolicy.section.sharing.summary\": \"Tunatumia watoa huduma walio na mipaka kupitisha, kulinda, kuwasilisha, na kusaidia jukwaa — sio kujiuza tena au kutumia data yako.\",\n    \"privacyPolicy.section.sharing.title\": \"Kushiriki na processors\",\n    \"privacyPolicy.section.usage.b1\": \"Thibitisha na kulinda akaunti yako\",\n    \"privacyPolicy.section.usage.b2\": \"Toa mafunzo ya AI na michakato ya bidhaa unazotumia waziwazi\",\n    \"privacyPolicy.section.usage.b3\": \"Fanya kazi ya msaada, bili, kufuata sheria, na mawasiliano ya uaminifu\",\n    \"privacyPolicy.section.usage.b4\": \"Gundua unyanyasaji, fuatilia matukio, na kudumisha uaminifu\",\n    \"privacyPolicy.section.usage.p1\": \"Matumizi ya msingi yanajumuisha uundaji wa akaunti, uthibitisho, usimamizi wa usajili, urekebishaji wa jukwaa, utoaji wa mafunzo, kupanga, msaada, kuzuia udanganyifu, kugundua unyanyasaji, na uchambuzi wa huduma. Kila matumizi yanapaswa kuunganishwa tena na madhumuni halali ya kibiashara au kisheria.\",\n    \"privacyPolicy.section.usage.p2\": \"Mahali ambapo ridhaa ni msingi, unaweza kujiondoa. Mahali ambapo utendaji wa mkataba au interesado halali ni msingi, tunalenga kueleza maana yake kwa maneno ya operesheni ili watumiaji wasibaki wanakisia.\",\n    \"privacyPolicy.section.usage.summary\": \"Tunatumia data kutoa huduma uliyotaka, kulinda jukwaa, na kufuata wajibu wa kisheria.\",\n    \"privacyPolicy.section.usage.title\": \"Jinsi tunavyotumia data yako\",\n    \"privacyPolicy.sidebar.ctaBody\": \"Tumia njia yetu ya ombi ya huduma binafsi iliyothibitishwa kwa usafirishaji au kufutwa, au wasiliana na operesheni za faragha kwa maswali deeper.\",\n    \"privacyPolicy.sidebar.ctaButton\": \"Fungua Simamisha Data Yangu\",\n    \"privacyPolicy.sidebar.ctaTitle\": \"Unahitaji kuchukua hatua?\",\n    \"privacyPolicy.sidebar.search\": \"Tafuta sera hii\",\n    \"privacyPolicy.sidebar.title\": \"Safiri sera\",\n    \"privacyPolicy.summary.title\": \"TL;DR — kile ambacho ni muhimu zaidi\",\n    \"privacyPolicy.table.collection.account\": \"Taarifa za akaunti\",\n    \"privacyPolicy.table.collection.accountValue\": \"Jina, barua pepe, mipangilio ya profaili, hali ya mpango\",\n    \"privacyPolicy.table.collection.connected\": \"Huduma zilizounganishwa\",\n    \"privacyPolicy.table.collection.connectedValue\": \"Matukio ya kalenda, tokeni za OAuth, metadata ya utambulisho wa profaili\",\n    \"privacyPolicy.table.collection.product\": \"Matumizi ya bidhaa\",\n    \"privacyPolicy.table.collection.productValue\": \"Matumizi ya kipengele, uchambuzi wa makosa, mifumo ya kikao\",\n    \"privacyPolicy.table.collection.support\": \"Rekodi za msaada\",\n    \"privacyPolicy.table.collection.supportValue\": \"Tiketi, maoni, maombi ya kisheria/faragha\",\n    \"privacyPolicy.table.retention.account\": \"Profaili ya akaunti\",\n    \"p